              "type": "string"
            },
            "type": "array"
          },
          "origin": {
            "type": [
              "string",
              "null"
            ]
          },
          "preview": {
            "description": "The first rows.",
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
