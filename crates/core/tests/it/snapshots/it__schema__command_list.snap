      "kind": "edit",
      "label": "Set properties",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "element": {
            "description": "The element after the change.",
            "oneOf": [
              {
                "properties": {
                  "align": {
                    "default": "left",
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ],
                    "type": "string"
                  },
                  "bold": {
                    "default": false,
                    "type": "boolean"
                  },
                  "fit": {
                    "default": "none",
                    "description": "How text reacts when it does not fit its box.",
