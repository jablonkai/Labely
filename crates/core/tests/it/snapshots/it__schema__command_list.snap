      },
      "undoable": true
    },
    {
      "description": "One table edit, tagged by `op`: insert_row/delete_row {at}, insert_column/delete_column {at}, set_cell {row, col, text, bold, align, font_size_pt, invert}, merge {row, col, rows, cols}, split {row, col}, resize_row {at, height}, resize_column {at, width} (relative weights), clear. Indices are 0-based. Returns {element}.",
      "id": "element.table_edit",
      "journal": true,
      "kind": "edit",
      "label": "Edit table",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "element": {
            "description": "The element after the change.",
            "oneOf": [
              {
                "properties": {
                  "align": {
                    "default": "left",
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ],
                    "type": "string"
                  },
                  "bold": {
                    "default": false,
                    "type": "boolean"
                  },
                  "direction": {
                    "description": "Horizontal, or vertical: one character per row, top to bottom.",
                    "oneOf": [
                      {
                        "enum": [
                          "horizontal"
                        ],
                        "type": "string"
                      },
                      {
                        "const": "vertical",
                        "description": "Characters stacked top to bottom; each source line is separated by a blank row.",
                        "type": "string"
                      }
                    ]
                  },
                  "fit": {
                    "default": "none",
                    "description": "How text reacts when it does not fit its box.",
                    "oneOf": [
                      {
                        "const": "none",
                        "description": "Keep the size; overflow is reported by `doc.check`.",
                        "type": "string"
                      },
                      {
                        "const": "shrink",
                        "description": "Shrink the font until the text fits.",
