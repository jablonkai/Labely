    {
      "description": "Embed CSV data (path or text) as the document's data source, replacing any other. Each row is one record printed as one label; bind columns as `{{column}}`. Returns the columns, the record count and the first rows.",
      "id": "data.attach_csv",
      "journal": true,
      "kind": "edit",
      "label": "Attach CSV",
      "menu": "data",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Summary of the attached data source.",
        "properties": {
          "columns": {
            "description": "Column names; bind them as `{{column}}`.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "origin": {
            "type": [
              "string",
              "null"
            ]
          },
          "preview": {
            "description": "The first rows.",
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "row_count": {
            "description": "Number of records.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "sheet": {
            "description": "Sheet that was read (spreadsheets only).",
            "type": [
              "string",
              "null"
            ]
          },
          "sheets": {
            "description": "All sheets in the workbook (spreadsheets only).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "columns",
          "row_count",
          "preview"
        ],
        "title": "DataSummary",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "delimiter": {
            "default": null,
            "description": "One-character field delimiter; detected from the first line when absent.",
            "type": [
              "string",
              "null"
            ]
          },
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "header": {
            "default": null,
            "description": "First row holds the column names (default true). Otherwise columns are A, B, C….",
            "type": [
              "boolean",
              "null"
            ]
          },
          "path": {
            "default": null,
            "description": "CSV file to read (UTF-8). Pass exactly one of `path` or `text`.",
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "default": null,
            "description": "CSV content inline.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "AttachCsvParams",
        "type": "object"
      },
      "undoable": true
    },
