    {
      "description": "Embed image files as the data source, replacing any other: one record per image with columns `image` (the asset) and `file` (the file name). An image element whose asset is `{{image}}` shows each record's picture; one filling the label is placed unless it exists (place: false skips it). Printing prints one label per image. 1–500 paths.",
      "id": "data.attach_images",
      "journal": true,
      "kind": "edit",
      "label": "Attach images",
      "menu": "data",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Summary of the attached data source.",
        "properties": {
          "columns": {
            "description": "Column names; bind them as `{{column}}`.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "element_id": {
            "description": "The image element that was placed, if any.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "origin": {
            "type": [
              "string",
              "null"
            ]
          },
          "preview": {
            "description": "The first rows.",
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "row_count": {
            "description": "Number of records.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "sheet": {
            "description": "Sheet that was read (spreadsheets only).",
            "type": [
              "string",
              "null"
            ]
          },
          "sheets": {
            "description": "All sheets in the workbook (spreadsheets only).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "columns",
          "row_count",
          "preview"
        ],
        "title": "AttachImagesOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "column": {
            "default": null,
            "description": "Column holding each record's image (default `image`).",
            "type": [
              "string",
              "null"
            ]
          },
          "dither": {
            "default": null,
            "description": "1-bit conversion of the placed element (default `floyd_steinberg`).",
            "enum": [
              "threshold",
              "floyd_steinberg",
              "atkinson",
              "bayer",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "fit": {
            "default": null,
            "description": "Fit of the placed element (default `contain`).",
            "enum": [
              "contain",
              "cover",
              "stretch",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "paths": {
            "description": "Image files (PNG, JPEG, BMP, WebP), one record each, in this order.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "place": {
            "default": null,
            "description": "Add an image element filling the label and bound to the column, unless one already\nuses it (default true).",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "paths"
        ],
        "title": "AttachImagesParams",
        "type": "object"
      },
      "undoable": true
    },
