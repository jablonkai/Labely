                  "type": "boolean"
                },
                "model": {
                  "description": "Printer model facts that commands need (subset of the registry entry).",
                  "properties": {
                    "density_default": {
                      "format": "uint8",
                      "maximum": 255,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "density_max": {
                      "format": "uint8",
                      "maximum": 255,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "density_min": {
                      "format": "uint8",
                      "maximum": 255,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "dpi": {
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "head_dots": {
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "id": {
                      "type": "string"
                    },
                    "max_width_mm": {
                      "format": "double",
                      "type": "number"
                    },
                    "media": {
                      "items": {
                        "description": "Media type of the label stock.",
                        "enum": [
                          "gap",
