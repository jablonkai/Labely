        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "address": {
            "default": null,
            "description": "Device address, e.g. `ble:…`, `usb:…`; defaults to the single connected printer.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "AddressParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Render and print at the connected model's dpi: one label per data record (`records` like `1,3,5-7`, default all) or `count` labels without data, with bindings and serials filled in. copies 1–999 (default 1) or per record from `copies_column`; density defaults to the label's, else the model's. Blocks until done. Run doc.check first.",
      "id": "print.submit",
      "journal": false,
      "kind": "device",
      "label": "Print",
      "menu": "print",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "address": {
            "type": "string"
          },
          "copies": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "density": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "dpi": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "duration_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "labels": {
            "description": "Distinct labels rendered (records or count, times pages).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "pages_printed": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "address",
          "labels",
          "pages_printed",
          "duration_ms",
          "copies",
          "density",
          "dpi"
        ],
        "title": "PrintOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "address": {
            "default": null,
            "description": "Printer address; defaults to the single connected printer.",
            "type": [
              "string",
              "null"
            ]
          },
          "copies": {
            "default": null,
            "description": "Number of copies, 1–999 (default 1).",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "copies_column": {
            "default": null,
            "description": "Column holding each record's copy count (0 skips the record); overrides `copies`.",
            "type": [
              "string",
              "null"
            ]
          },
          "count": {
            "default": null,
            "description": "Labels to print without a data source, 1–5000 (default 1); serials advance per label.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "density": {
            "default": null,
            "description": "Print density; defaults to the label's density, else the model default.",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "records": {
            "default": null,
            "description": "Data records to print, 1-based: `all` (default), `3`, `1,4,6-9`. Needs a data source.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "PrintParams",
        "type": "object"
      },
      "shortcut": "Ctrl+P",
      "undoable": false
    }
  ],
  "envelope_params": {
    "coalesce": "string key; consecutive edits with the same key form one undo step",
    "terse": "boolean; true drops `result` from the envelope"
  }
}
