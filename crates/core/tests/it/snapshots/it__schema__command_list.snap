    {
      "description": "Block until the job is done, failed or cancelled, or timeout_ms (default 60000) passes; returns the job. Check `state`: it is still `queued` or `printing` after a timeout.",
      "id": "job.wait",
      "journal": false,
      "kind": "device",
      "label": "Wait for print job",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "A queued, running or finished print job.",
        "properties": {
          "address": {
            "type": "string"
          },
          "copies": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "density": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "doc_name": {
            "description": "Name of the printed document.",
            "type": "string"
          },
          "duration_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "error": {
            "description": "Why the job failed or was cancelled.",
            "properties": {
              "accepted": {
                "description": "Accepted values or nearest valid ids.",
                "items": {
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "code": {
                "description": "Stable error codes (prior-art §4.2 item 9).",
                "oneOf": [
                  {
                    "enum": [
                      "unknown_command",
                      "bad_params",
                      "disabled",
                      "no_document",
                      "not_found",
                      "device_unavailable",
                      "device_error",
                      "cancelled",
                      "internal"
                    ],
                    "type": "string"
                  },
                  {
                    "const": "forbidden",
                    "description": "Refused by the session policy (file roots, print gating).",
                    "type": "string"
                  }
                ]
              },
              "hint": {
                "description": "What to do next.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": "string"
              },
              "param": {
                "description": "Offending param path, e.g. `width_mm` or `props.font_size_pt`.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "`job-<n>`, unique within the session.",
            "type": "string"
          },
          "labels": {
            "description": "Distinct labels (records or count, times pages).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "model": {
            "description": "Printer model id, when known.",
            "type": [
              "string",
              "null"
            ]
          },
          "pages_done": {
            "description": "Pages printed so far.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "pages_total": {
            "description": "Pages the printer will feed (labels × copies).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "description": "Where a job is.",
            "enum": [
              "queued",
              "printing",
              "done",
              "failed",
              "cancelled"
            ],
            "type": "string"
          },
          "submitted_at": {
            "description": "Local time, `YYYY-MM-DD HH:MM:SS`.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "state",
          "address",
          "doc_name",
          "labels",
          "copies",
          "density",
          "pages_total",
          "pages_done",
          "submitted_at"
        ],
        "title": "JobInfo",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "timeout_ms": {
            "default": null,
            "description": "Longest wait in milliseconds (default 60000, max 600000).",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "title": "WaitParams",
        "type": "object"
      },
      "undoable": false
    },
