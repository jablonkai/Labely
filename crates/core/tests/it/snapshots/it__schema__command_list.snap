    {
      "description": "Pause the print queue: the printing job finishes, queued jobs wait for job.resume.",
      "id": "job.pause",
      "journal": false,
      "kind": "device",
      "label": "Pause print queue",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "paused": {
            "type": "boolean"
          }
        },
        "required": [
          "paused"
        ],
        "title": "PausedOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Params for commands that take none.",
        "title": "NoParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Resume a paused print queue.",
      "id": "job.resume",
      "journal": false,
      "kind": "device",
      "label": "Resume print queue",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "paused": {
            "type": "boolean"
          }
        },
        "required": [
          "paused"
        ],
        "title": "PausedOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Params for commands that take none.",
        "title": "NoParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Remove finished jobs from job.list. The print history keeps them.",
      "id": "job.clear",
      "journal": false,
      "kind": "device",
      "label": "Clear finished jobs",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "removed": {
            "description": "Finished jobs removed from the list.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "removed"
        ],
        "title": "ClearOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Params for commands that take none.",
        "title": "NoParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Printed jobs, newest first (limit default 50, max 1000; offset). Each entry with a `file` can be reopened with job.history_open.",
      "id": "job.history",
      "journal": false,
      "kind": "query",
      "label": "Print history",
      "menu": "print",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "entries": {
            "items": {
              "description": "One printed job in the history.",
              "properties": {
                "address": {
                  "type": "string"
                },
                "copies": {
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                "doc_name": {
                  "type": "string"
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "file": {
                  "description": "Snapshot file name in the history directory.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "id": {
                  "description": "`YYYYMMDD-HHMMSS[-n]`.",
                  "type": "string"
                },
                "labels": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pages_printed": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "printed_at": {
                  "description": "Local time the job finished, `YYYY-MM-DD HH:MM:SS`.",
                  "type": "string"
                },
                "state": {
                  "description": "`done`, `failed` or `cancelled`.",
                  "enum": [
                    "queued",
                    "printing",
                    "done",
                    "failed",
                    "cancelled"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "printed_at",
                "doc_name",
                "address",
                "labels",
                "copies",
                "pages_printed",
                "state"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "total": {
            "description": "Entries in the whole history.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "total",
          "entries"
        ],
        "title": "HistoryOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": null,
            "description": "Most entries to return, newest first (default 50, max 1000).",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "default": null,
            "description": "Entries to skip (default 0).",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "title": "HistoryParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Delete print-history entries and their document snapshots. Cannot be undone.",
      "id": "job.history_delete",
      "journal": false,
      "kind": "edit",
      "label": "Delete history entries",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "deleted": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "deleted"
        ],
        "title": "HistoryDeleteOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "ids": {
            "description": "History entry ids from job.history.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "ids"
        ],
        "title": "HistoryDeleteParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Delete the whole print history and its document snapshots. Cannot be undone.",
      "id": "job.history_clear",
      "journal": false,
      "kind": "edit",
      "label": "Clear print history",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "deleted": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "deleted"
        ],
        "title": "HistoryDeleteOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Params for commands that take none.",
        "title": "NoParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Open the document as it was printed in a history entry, as a new unsaved document, and make it active. Print it again with print.submit.",
      "id": "job.history_open",
      "journal": true,
      "kind": "edit",
      "label": "Open from history",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "doc_id",
          "name"
        ],
        "title": "HistoryOpenOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "History entry id from job.history.",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "HistoryOpenParams",
        "type": "object"
      },
      "undoable": false
    }
  ],
  "envelope_params": {
    "coalesce": "string key; consecutive edits with the same key form one undo step",
    "terse": "boolean; true drops `result` from the envelope"
  }
}
