---
source: crates/core/tests/it/schema.rs
expression: r
---
{
  "api_version": 3,
  "commands": [
    {
      "description": "List every command with its kind, description and JSON Schemas for params and result. Optional `prefix` filters ids (e.g. `element.`).",
      "id": "command.list",
      "journal": false,
      "kind": "query",
      "label": "List commands",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "api_version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "commands": {
            "items": {
              "description": "Listing entry returned by `command.list`.",
              "properties": {
                "description": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "journal": {
                  "type": "boolean"
                },
                "kind": {
                  "description": "What a command does; decides undo and batch behaviour.",
                  "oneOf": [
                    {
                      "const": "query",
                      "description": "Reads state; pushes no undo step.",
                      "type": "string"
                    },
                    {
                      "const": "edit",
                      "description": "Changes a document; one undo step when `undoable`.",
                      "type": "string"
                    },
                    {
                      "const": "device",
                      "description": "Talks to a printer; pushes no undo step and is refused inside atomic batches.",
                      "type": "string"
                    },
                    {
                      "const": "ui",
                      "description": "Changes view state only (selection, zoom, panels); never touches a document.",
                      "type": "string"
                    }
                  ]
                },
                "label": {
                  "type": "string"
                },
                "menu": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "output_schema": {
                  "description": "JSON Schema of `result`."
                },
                "params_schema": {
                  "description": "JSON Schema (2020-12, refs inlined) of the params object."
                },
                "shortcut": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "undoable": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "label",
                "description",
                "kind",
                "journal",
                "undoable",
                "params_schema",
                "output_schema"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "envelope_params": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Params accepted by every command in addition to its own.",
            "type": "object"
          }
        },
        "required": [
          "api_version",
          "commands",
          "envelope_params"
        ],
        "title": "ListOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "prefix": {
            "default": null,
            "description": "Only list ids starting with this prefix, e.g. `element.`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "ListParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Run several commands as one. Params: steps [{id, params}], atomic (default true: all or nothing, one undo step), stop_on_error (default true), label, terse. A param string that is exactly `$N`, `$N.path` or `$last.path` takes a value from an earlier step's result, e.g. `$0.id` or `$1.created.0`; `$$` escapes a literal `$`. Max 128 steps.",
      "id": "command.batch",
      "journal": false,
      "kind": "edit",
      "label": "Run batch",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "completed": {
            "description": "Steps that succeeded.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "created": {
            "description": "Elements created by all steps.",
            "items": {
              "description": "Stable element id, unique within a document.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "failed": {
            "description": "Steps that failed (only non-zero when `atomic` is false).",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "results": {
            "items": {
              "properties": {
                "error": {
                  "description": "A command failure; serialised as the envelope's `error` object.",
                  "properties": {
                    "accepted": {
                      "description": "Accepted values or nearest valid ids.",
                      "items": {
                        "type": "string"
                      },
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "code": {
                      "description": "Stable error codes (prior-art §4.2 item 9).",
                      "oneOf": [
                        {
                          "enum": [
                            "unknown_command",
                            "bad_params",
                            "disabled",
                            "no_document",
                            "not_found",
                            "device_unavailable",
                            "device_error",
                            "cancelled",
                            "internal"
                          ],
                          "type": "string"
                        },
                        {
                          "const": "forbidden",
                          "description": "Refused by the session policy (file roots, print gating).",
                          "type": "string"
                        }
                      ]
                    },
                    "hint": {
                      "description": "What to do next.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "param": {
                      "description": "Offending param path, e.g. `width_mm` or `props.font_size_pt`.",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "ok": {
                  "type": "boolean"
                },
                "result": true
              },
              "required": [
                "ok"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "completed",
          "failed",
          "results",
          "created"
        ],
        "title": "BatchOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "atomic": {
            "default": true,
            "description": "All or nothing (default true): any failure restores the state from before the batch,\nand success is one undo step. `print.*`, `device.*`, `doc.open`, `doc.close`,\n`history.*` and nested batches are refused.",
            "type": "boolean"
          },
          "label": {
            "default": null,
            "description": "Undo step label (default `command.batch`).",
            "type": [
              "string",
              "null"
            ]
          },
          "steps": {
            "description": "Steps to run in order (max 128).",
            "items": {
              "additionalProperties": false,
              "description": "One step: a command id and its params.",
              "properties": {
                "id": {
                  "description": "Command id, e.g. `element.add_text`.",
                  "type": "string"
                },
                "params": {
                  "default": null,
                  "description": "Params object. A string that is exactly `$N`, `$N.path` or `$last.path` is replaced by a\nvalue from an earlier step's result (`$0.id`, `$1.created.0`); `$$…` is a literal `$…`."
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "stop_on_error": {
            "default": true,
            "description": "Stop at the first failed step (default true; always true when atomic).",
            "type": "boolean"
          },
          "terse": {
            "default": false,
            "description": "Omit per-step `result` from the reply.",
            "type": "boolean"
          }
        },
        "required": [
          "steps"
        ],
        "title": "BatchParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Create an empty label document and make it active. Sizes in mm (width across the printhead, height along the feed). Returns {doc_id}.",
      "id": "doc.new",
      "journal": true,
      "kind": "edit",
      "label": "New document",
      "menu": "file",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "doc_id": {
            "description": "Id of the document, usable as `doc_id` in other commands.",
            "type": "string"
          }
        },
        "required": [
          "doc_id"
        ],
        "title": "DocIdOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "corner_radius_mm": {
            "default": null,
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "density": {
            "default": null,
            "description": "Print density; the model default is used when absent.",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "height_mm": {
            "description": "Label length along the feed, mm.",
            "format": "double",
            "type": "number"
          },
          "media": {
            "default": null,
            "description": "Label stock (default `gap`).",
            "enum": [
              "gap",
              "black_mark",
              "continuous",
              "transparent",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "default": null,
            "description": "Document name (default `Untitled`).",
            "type": [
              "string",
              "null"
            ]
          },
          "printer_model": {
            "default": null,
            "description": "Printer model id, e.g. `niimbot.b21_pro`; sets the preview/check dpi.",
            "type": [
              "string",
              "null"
            ]
          },
          "width_mm": {
            "description": "Label width across the printhead, mm.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "width_mm",
          "height_mm"
        ],
        "title": "NewParams",
        "type": "object"
      },
      "shortcut": "Ctrl+N",
      "undoable": true
    },
    {
      "description": "Open a `.labely` file as a new document and make it active. Returns {doc_id, name}.",
      "id": "doc.open",
      "journal": true,
      "kind": "edit",
      "label": "Open document",
      "menu": "file",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "doc_id",
          "name"
        ],
        "title": "OpenOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Path of a `.labely` file.",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "OpenParams",
        "type": "object"
      },
      "shortcut": "Ctrl+O",
      "undoable": false
    },
    {
      "description": "Write the document as pretty `.labely` JSON. `path` defaults to the file it was opened from or last saved to.",
      "id": "doc.save",
      "journal": false,
      "kind": "query",
      "label": "Save document",
      "menu": "file",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "bytes": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes"
        ],
        "title": "SaveOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "default": null,
            "description": "Target path; defaults to where the document was opened or last saved.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "SaveParams",
        "type": "object"
      },
      "shortcut": "Ctrl+S",
      "undoable": false
    },
    {
      "description": "Close a document (default: active) and drop its history. Unsaved changes are lost; a warning says so.",
      "id": "doc.close",
      "journal": true,
      "kind": "edit",
      "label": "Close document",
      "menu": "file",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "active": {
            "description": "The new active document, if any remain open.",
            "type": [
              "string",
              "null"
            ]
          },
          "closed": {
            "type": "string"
          }
        },
        "required": [
          "closed",
          "active"
        ],
        "title": "CloseOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "default": null,
            "description": "Document id; defaults to the active document.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "DocIdParams",
        "type": "object"
      },
      "shortcut": "Ctrl+W",
      "undoable": false
    },
    {
      "description": "List the open documents in the order they were opened: doc_id, name, path, dirty and which one is active.",
      "id": "doc.list",
      "journal": false,
      "kind": "query",
      "label": "Open documents",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "docs": {
            "description": "Open documents in the order they were opened.",
            "items": {
              "properties": {
                "active": {
                  "type": "boolean"
                },
                "dirty": {
                  "type": "boolean"
                },
                "doc_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "doc_id",
                "name",
                "path",
                "dirty",
                "active"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "docs"
        ],
        "title": "ListOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "title": "ListParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Make an open document the active one; commands without doc_id then act on it.",
      "id": "doc.activate",
      "journal": true,
      "kind": "edit",
      "label": "Switch document",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "active": {
            "type": "string"
          }
        },
        "required": [
          "active"
        ],
        "title": "ActivateOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "type": "string"
          }
        },
        "required": [
          "doc_id"
        ],
        "title": "ActivateParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Create a new, unsaved document from a template (`ref` from template.list) and make it active. Returns {doc_id, name}.",
      "id": "template.new",
      "journal": true,
      "kind": "edit",
      "label": "New from template",
      "menu": "file",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "doc_id",
          "name"
        ],
        "title": "OpenOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "name": {
            "default": null,
            "description": "Name of the new document (default: the template's name).",
            "type": [
              "string",
              "null"
            ]
          },
          "ref": {
            "description": "Template reference from template.list, e.g. `starter:price-tag` or `my:Shop/Shelf`.",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "title": "NewParams",
        "type": "object"
      },
      "shortcut": "Ctrl+Shift+N",
      "undoable": false
    },
    {
      "description": "Save a copy of the document (default: active) in the template library under `name` (default: the document name) in `folder` (default folder when absent). Fails if it exists unless overwrite is true. Returns {ref}.",
      "id": "template.save",
      "journal": false,
      "kind": "edit",
      "label": "Save as template",
      "menu": "file",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "ref": {
            "description": "Reference of the saved, moved or copied template.",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "title": "RefOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "folder": {
            "default": null,
            "description": "Library folder (default: the default folder); created when missing.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "default": null,
            "description": "Template name (default: the document's name).",
            "type": [
              "string",
              "null"
            ]
          },
          "overwrite": {
            "default": null,
            "description": "Replace a template of the same name (default false).",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "title": "SaveParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Write one label as a 1-bit PNG: the exact print raster at `dpi` (default: the model's, else 203), for `page` and data `record` (1-based, default 1).",
      "id": "export.png",
      "journal": false,
      "kind": "query",
      "label": "Export PNG",
      "menu": "file",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "bytes": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "dpi": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "height_dots": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "width_dots": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "bytes",
          "width_dots",
          "height_dots",
          "dpi"
        ],
        "title": "PngOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "dpi": {
            "default": null,
            "description": "Resolution in dpi; defaults to the label's printer model dpi, else 203.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "page": {
            "default": null,
            "description": "0-based page index (default 0).",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "path": {
            "description": "Target `.png` file.",
            "type": "string"
          },
          "record": {
            "default": null,
            "description": "Data record, 1-based (default 1).",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "path"
        ],
        "title": "PngParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Write labels to a PDF, one page per label sized to the label in mm, each the exact 1-bit print raster at `dpi`. With data: one label per record (`records` like `1,3,5-7`, default all); without: `count` labels (default 1) with serials advancing.",
      "id": "export.pdf",
      "journal": false,
      "kind": "query",
      "label": "Export PDF",
      "menu": "file",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "bytes": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "dpi": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "pages": {
            "description": "PDF pages written: labels × document pages.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes",
          "pages",
          "dpi"
        ],
        "title": "PdfOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "count": {
            "default": null,
            "description": "Labels without a data source, 1–5000 (default 1); serials advance per label.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "dpi": {
            "default": null,
            "description": "Raster resolution in dpi; defaults to the label's printer model dpi, else 203.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "path": {
            "description": "Target `.pdf` file.",
            "type": "string"
          },
          "records": {
            "default": null,
            "description": "Data records, 1-based: `all` (default), `3`, `1,4,6-9`. Needs a data source.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path"
        ],
        "title": "PdfParams",
        "type": "object"
      },
      "shortcut": "Ctrl+E",
      "undoable": false
    },
    {
      "description": "List the starter templates and the local library: {library, folders, templates: [{ref, name, folder, starter, width_mm, height_mm, printer_model}]}. `query` filters by name; `folder` lists one library folder only. Open one with template.new {ref}.",
      "id": "template.list",
      "journal": false,
      "kind": "query",
      "label": "Templates",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "folders": {
            "description": "Library folders besides the default one.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "library": {
            "description": "Library directory, when the session has one.",
            "type": [
              "string",
              "null"
            ]
          },
          "templates": {
            "items": {
              "description": "One `template.list` entry.",
              "properties": {
                "folder": {
                  "description": "Library folder; empty for the default folder and for starters.",
                  "type": "string"
                },
                "height_mm": {
                  "format": "double",
                  "type": "number"
                },
                "name": {
                  "type": "string"
                },
                "printer_model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ref": {
                  "description": "Reference for the other `template.*` commands.",
                  "type": "string"
                },
                "starter": {
                  "type": "boolean"
                },
                "width_mm": {
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "ref",
                "name",
                "folder",
                "starter",
                "width_mm",
                "height_mm"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "folders",
          "templates"
        ],
        "title": "ListOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "folder": {
            "default": null,
            "description": "Only this library folder (`\"\"` is the default folder); starters are left out.",
            "type": [
              "string",
              "null"
            ]
          },
          "query": {
            "default": null,
            "description": "Case-insensitive part of the name to look for.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "ListParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Delete a library template (`my:…`). Starters cannot be deleted. Cannot be undone.",
      "id": "template.delete",
      "journal": false,
      "kind": "edit",
      "label": "Delete template",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "title": "DeleteOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "title": "RefParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Rename a library template and/or move it to another folder. Fails if the target exists. Returns the new {ref}.",
      "id": "template.move",
      "journal": false,
      "kind": "edit",
      "label": "Rename or move template",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "ref": {
            "description": "Reference of the saved, moved or copied template.",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "title": "RefOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "folder": {
            "default": null,
            "description": "Target folder, `\"\"` for the default folder (default: unchanged); created when missing.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "default": null,
            "description": "New name (default: unchanged).",
            "type": [
              "string",
              "null"
            ]
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "title": "MoveParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Copy a template (a starter or a library one) into the library. Without `name` the copy is numbered (`Name 2`). Returns the copy's {ref}.",
      "id": "template.duplicate",
      "journal": false,
      "kind": "edit",
      "label": "Duplicate template",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "ref": {
            "description": "Reference of the saved, moved or copied template.",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "title": "RefOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "folder": {
            "default": null,
            "description": "Folder of the copy (default: the original's; the default folder for starters).",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "default": null,
            "description": "Name of the copy (default: the original's, numbered when taken).",
            "type": [
              "string",
              "null"
            ]
          },
          "ref": {
            "description": "Template to copy; starters may be copied into the library.",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "title": "DuplicateParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Create, rename or delete a template library folder (`op`). Delete needs an empty folder unless with_templates is true. Returns the folders.",
      "id": "template.folder",
      "journal": false,
      "kind": "edit",
      "label": "Template folder",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "folders": {
            "description": "Library folders after the change.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "folders"
        ],
        "title": "FolderOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "folder": {
            "description": "Folder to create, rename or delete.",
            "type": "string"
          },
          "op": {
            "description": "Folder operation.",
            "enum": [
              "create",
              "rename",
              "delete"
            ],
            "type": "string"
          },
          "to": {
            "default": null,
            "description": "New name, for `rename`.",
            "type": [
              "string",
              "null"
            ]
          },
          "with_templates": {
            "default": null,
            "description": "`delete`: also delete the templates in it (default false: it must be empty).",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "op",
          "folder"
        ],
        "title": "FolderParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Return the full document JSON (units mm, elements with ids) plus doc_id, path, dirty and undo/redo availability.",
      "id": "doc.get",
      "journal": false,
      "kind": "query",
      "label": "Get document",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "can_redo": {
            "type": "boolean"
          },
          "can_undo": {
            "type": "boolean"
          },
          "dirty": {
            "description": "Changed since the last open/save (always true for never-saved documents).",
            "type": "boolean"
          },
          "doc_id": {
            "type": "string"
          },
          "document": {
            "additionalProperties": false,
            "description": "The full `.labely` document. Units are mm.",
            "properties": {
              "assets": {
                "additionalProperties": {
                  "additionalProperties": false,
                  "description": "Embedded binary asset.",
                  "properties": {
                    "data_base64": {
                      "description": "Standard base64 of the bytes.",
                      "type": "string"
                    },
                    "mime": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "mime",
                    "data_base64"
                  ],
                  "type": "object"
                },
                "description": "Embedded assets keyed by lowercase hex sha256 of the bytes.",
                "type": "object"
              },
              "data": {
                "additionalProperties": false,
                "description": "Attached data source; each row is one record, printed as one label (v2).",
                "properties": {
                  "columns": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "origin": {
                    "description": "File name the data came from, for display only.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rows": {
                    "description": "Rows of cells; a short row reads as empty cells.",
                    "items": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "columns",
                  "rows"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "format_version": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "label": {
                "additionalProperties": false,
                "description": "Physical label stock.",
                "properties": {
                  "corner_radius_mm": {
                    "default": 0.0,
                    "format": "double",
                    "type": "number"
                  },
                  "density": {
                    "description": "Preferred density; the model default is used when absent.",
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "height_mm": {
                    "description": "Length along the feed, mm.",
                    "format": "double",
                    "type": "number"
                  },
                  "media": {
                    "default": "gap",
                    "description": "Media type of the label stock.",
                    "enum": [
                      "gap",
                      "black_mark",
                      "continuous",
                      "transparent"
                    ],
                    "type": "string"
                  },
                  "printer_model": {
                    "description": "Registry id of the intended printer model, e.g. `niimbot.b21_pro`.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "width_mm": {
                    "description": "Width across the printhead, mm.",
                    "format": "double",
                    "type": "number"
                  }
                },
                "required": [
                  "width_mm",
                  "height_mm",
                  "corner_radius_mm",
                  "media"
                ],
                "type": "object"
              },
              "name": {
                "type": "string"
              },
              "next_id": {
                "description": "Next id to hand out.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "pages": {
                "description": "Pages; Phase 1 documents have exactly one.",
                "items": {
                  "additionalProperties": false,
                  "description": "One printed page.",
                  "properties": {
                    "elements": {
                      "description": "Z-order: later elements draw on top.",
                      "items": {
                        "description": "A positioned element. The frame is the unrotated box; rotation is about its centre.",
                        "oneOf": [
                          {
                            "properties": {
                              "align": {
                                "default": "left",
                                "enum": [
                                  "left",
                                  "center",
                                  "right"
                                ],
                                "type": "string"
                              },
                              "bold": {
                                "default": false,
                                "type": "boolean"
                              },
                              "direction": {
                                "description": "Horizontal, or vertical: one character per row, top to bottom.",
                                "oneOf": [
                                  {
                                    "enum": [
                                      "horizontal"
                                    ],
                                    "type": "string"
                                  },
                                  {
                                    "const": "vertical",
                                    "description": "Characters stacked top to bottom; each source line is separated by a blank row.",
                                    "type": "string"
                                  }
                                ]
                              },
                              "fit": {
                                "default": "none",
                                "description": "How text reacts when it does not fit its box.",
                                "oneOf": [
                                  {
                                    "const": "none",
                                    "description": "Keep the size; overflow is reported by `doc.check`.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "shrink",
                                    "description": "Shrink the font until the text fits.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "fill",
                                    "description": "Grow or shrink the font to the largest size that fits the box.",
                                    "type": "string"
                                  }
                                ]
                              },
                              "font_family": {
                                "default": "Noto Sans",
                                "type": "string"
                              },
                              "font_size_pt": {
                                "default": 12.0,
                                "format": "double",
                                "type": "number"
                              },
                              "invert": {
                                "default": false,
                                "description": "White text on black.",
                                "type": "boolean"
                              },
                              "italic": {
                                "default": false,
                                "type": "boolean"
                              },
                              "letter_spacing_mm": {
                                "default": 0.0,
                                "format": "double",
                                "type": "number"
                              },
                              "line_spacing": {
                                "default": 1.0,
                                "description": "Line height multiplier.",
                                "format": "double",
                                "type": "number"
                              },
                              "max_length_mm": {
                                "description": "Warn in `doc.check` when the longest printed line is wider than this, mm.",
                                "format": "double",
                                "type": [
                                  "number",
                                  "null"
                                ]
                              },
                              "spans": {
                                "description": "Rich-text style ranges over `text` (horizontal text only). A `{{binding}}` that\ncrosses a span edge is not substituted.",
                                "items": {
                                  "additionalProperties": false,
                                  "description": "Style for a range of a text element's `text`. Unset fields keep the element's style;\nlater spans win where they overlap.",
                                  "properties": {
                                    "bold": {
                                      "type": [
                                        "boolean",
                                        "null"
                                      ]
                                    },
                                    "end": {
                                      "description": "One past the last character.",
                                      "format": "uint",
                                      "minimum": 0,
                                      "type": "integer"
                                    },
                                    "font_size_pt": {
                                      "format": "double",
                                      "type": [
                                        "number",
                                        "null"
                                      ]
                                    },
                                    "italic": {
                                      "type": [
                                        "boolean",
                                        "null"
                                      ]
                                    },
                                    "start": {
                                      "description": "First character (Unicode scalar index into `text`).",
                                      "format": "uint",
                                      "minimum": 0,
                                      "type": "integer"
                                    },
                                    "underline": {
                                      "type": [
                                        "boolean",
                                        "null"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "start",
                                    "end"
                                  ],
                                  "type": "object"
                                },
                                "type": "array"
                              },
                              "text": {
                                "description": "Text; may contain `{{variable}}` bindings and newlines.",
                                "type": "string"
                              },
                              "type": {
                                "const": "text",
                                "type": "string"
                              },
                              "underline": {
                                "default": false,
                                "type": "boolean"
                              },
                              "valign": {
                                "default": "top",
                                "enum": [
                                  "top",
                                  "middle",
                                  "bottom"
                                ],
                                "type": "string"
                              },
                              "wrap": {
                                "default": true,
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "type",
                              "text",
                              "font_family",
                              "font_size_pt",
                              "bold",
                              "italic",
                              "underline",
                              "align",
                              "valign",
                              "line_spacing",
                              "letter_spacing_mm",
                              "wrap",
                              "fit",
                              "invert"
                            ],
                            "type": "object"
                          },
                          {
                            "properties": {
                              "data": {
                                "type": "string"
                              },
                              "human_readable": {
                                "default": "below",
                                "enum": [
                                  "none",
                                  "below",
                                  "above"
                                ],
                                "type": "string"
                              },
                              "symbology": {
                                "default": "code128",
                                "description": "1D symbologies.",
                                "oneOf": [
                                  {
                                    "enum": [
                                      "code39",
                                      "code93",
                                      "ean13",
                                      "ean8",
                                      "upc_a",
                                      "upc_e",
                                      "itf",
                                      "codabar"
                                    ],
                                    "type": "string"
                                  },
                                  {
                                    "const": "code128",
                                    "description": "Code 128, code set chosen automatically.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "code128_a",
                                    "description": "Code 128 forced to code set A (upper case, digits, control characters).",
                                    "type": "string"
                                  },
                                  {
                                    "const": "code128_b",
                                    "description": "Code 128 forced to code set B (printable ASCII).",
                                    "type": "string"
                                  },
                                  {
                                    "const": "code128_c",
                                    "description": "Code 128 forced to code set C (an even number of digits).",
                                    "type": "string"
                                  },
                                  {
                                    "const": "gs1_128",
                                    "description": "GS1-128: application identifiers in brackets, e.g. `(01)09501101530003(17)250101`.",
                                    "type": "string"
                                  }
                                ]
                              },
                              "text_size_pt": {
                                "default": 8.0,
                                "format": "double",
                                "type": "number"
                              },
                              "type": {
                                "const": "barcode",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "data",
                              "symbology",
                              "human_readable",
                              "text_size_pt"
                            ],
                            "type": "object"
                          },
                          {
                            "properties": {
                              "data": {
                                "type": "string"
                              },
                              "ecc": {
                                "default": "M",
                                "description": "QR error-correction level.",
                                "enum": [
                                  "L",
                                  "M",
                                  "Q",
                                  "H"
                                ],
                                "type": "string"
                              },
                              "symbology": {
                                "default": "qr",
                                "description": "2D symbologies.",
                                "enum": [
                                  "qr",
                                  "data_matrix",
                                  "pdf417",
                                  "aztec"
                                ],
                                "type": "string"
                              },
                              "type": {
                                "const": "code2d",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "data",
                              "symbology",
                              "ecc"
                            ],
                            "type": "object"
                          },
                          {
                            "properties": {
                              "asset": {
                                "description": "Key into [`Document::assets`].",
                                "type": "string"
                              },
                              "brightness": {
                                "default": 0.0,
                                "description": "-1.0 … 1.0",
                                "format": "double",
                                "type": "number"
                              },
                              "contrast": {
                                "default": 0.0,
                                "description": "-1.0 … 1.0",
                                "format": "double",
                                "type": "number"
                              },
                              "crop": {
                                "additionalProperties": false,
                                "description": "Part of the source image to use, as fractions of its size; the whole image if absent.",
                                "properties": {
                                  "bottom": {
                                    "format": "double",
                                    "type": "number"
                                  },
                                  "left": {
                                    "format": "double",
                                    "type": "number"
                                  },
                                  "right": {
                                    "format": "double",
                                    "type": "number"
                                  },
                                  "top": {
                                    "format": "double",
                                    "type": "number"
                                  }
                                },
                                "required": [
                                  "left",
                                  "top",
                                  "right",
                                  "bottom"
                                ],
                                "type": [
                                  "object",
                                  "null"
                                ]
                              },
                              "dither": {
                                "default": "floyd_steinberg",
                                "description": "1-bit conversion for images.",
                                "enum": [
                                  "threshold",
                                  "floyd_steinberg",
                                  "atkinson",
                                  "bayer"
                                ],
                                "type": "string"
                              },
                              "fit": {
                                "default": "contain",
                                "enum": [
                                  "contain",
                                  "cover",
                                  "stretch"
                                ],
                                "type": "string"
                              },
                              "invert": {
                                "default": false,
                                "type": "boolean"
                              },
                              "threshold": {
                                "default": 128,
                                "description": "0–255 cut-off for `threshold` and the gray point for dithering.",
                                "format": "uint8",
                                "maximum": 255,
                                "minimum": 0,
                                "type": "integer"
                              },
                              "type": {
                                "const": "image",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "asset",
                              "fit",
                              "dither",
                              "threshold",
                              "brightness",
                              "contrast",
                              "invert"
                            ],
                            "type": "object"
                          },
                          {
                            "properties": {
                              "corner_radius_mm": {
                                "default": 0.0,
                                "description": "Rect only.",
                                "format": "double",
                                "type": "number"
                              },
                              "fill": {
                                "default": false,
                                "type": "boolean"
                              },
                              "stroke_mm": {
                                "default": 0.3,
                                "format": "double",
                                "type": "number"
                              },
                              "type": {
                                "const": "rect",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "stroke_mm",
                              "fill",
                              "corner_radius_mm"
                            ],
                            "type": "object"
                          },
                          {
                            "properties": {
                              "corner_radius_mm": {
                                "default": 0.0,
                                "description": "Rect only.",
                                "format": "double",
                                "type": "number"
                              },
                              "fill": {
                                "default": false,
                                "type": "boolean"
                              },
                              "stroke_mm": {
                                "default": 0.3,
                                "format": "double",
                                "type": "number"
                              },
                              "type": {
                                "const": "ellipse",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "stroke_mm",
                              "fill",
                              "corner_radius_mm"
                            ],
                            "type": "object"
                          },
                          {
                            "description": "A line from the frame's top-left `(x, y)` to `(x + width, y + height)`.",
                            "properties": {
                              "dash_mm": {
                                "description": "Dash and gap length in mm; solid when absent.",
                                "items": {
                                  "format": "double",
                                  "type": "number"
                                },
                                "maxItems": 2,
                                "minItems": 2,
                                "type": [
                                  "array",
                                  "null"
                                ]
                              },
                              "stroke_mm": {
                                "default": 0.3,
                                "format": "double",
                                "type": "number"
                              },
                              "type": {
                                "const": "line",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "stroke_mm"
                            ],
                            "type": "object"
                          },
                          {
                            "description": "A grid that fills its frame. Column widths and row heights are relative weights, so resizing\nthe element scales the table.",
                            "properties": {
                              "align": {
                                "default": "center",
                                "description": "Default cell alignment.",
                                "enum": [
                                  "left",
                                  "center",
                                  "right"
                                ],
                                "type": "string"
                              },
                              "cells": {
                                "description": "Row-major cells: `row_heights.len()` rows of `column_widths.len()` cells.",
                                "items": {
                                  "items": {
                                    "additionalProperties": false,
                                    "description": "One table cell. Style fields override the table defaults.",
                                    "properties": {
                                      "align": {
                                        "enum": [
                                          "left",
                                          "center",
                                          "right",
                                          null
                                        ],
                                        "type": [
                                          "string",
                                          "null"
                                        ]
                                      },
                                      "bold": {
                                        "type": "boolean"
                                      },
                                      "font_size_pt": {
                                        "format": "double",
                                        "type": [
                                          "number",
                                          "null"
                                        ]
                                      },
                                      "invert": {
                                        "description": "White text on a black cell.",
                                        "type": "boolean"
                                      },
                                      "text": {
                                        "description": "Cell text; may contain `{{name}}` bindings and newlines.",
                                        "type": "string"
                                      }
                                    },
                                    "type": "object"
                                  },
                                  "type": "array"
                                },
                                "type": "array"
                              },
                              "column_widths": {
                                "description": "Relative column widths (weights > 0).",
                                "items": {
                                  "format": "double",
                                  "type": "number"
                                },
                                "type": "array"
                              },
                              "font_family": {
                                "default": "Noto Sans",
                                "type": "string"
                              },
                              "font_size_pt": {
                                "default": 8.0,
                                "description": "Default cell font size; text shrinks to fit its cell.",
                                "format": "double",
                                "type": "number"
                              },
                              "merges": {
                                "description": "Merged cell ranges; the top-left cell's content fills the range.",
                                "items": {
                                  "additionalProperties": false,
                                  "description": "A rectangular block of cells, 0-based.",
                                  "properties": {
                                    "col": {
                                      "format": "uint",
                                      "minimum": 0,
                                      "type": "integer"
                                    },
                                    "cols": {
                                      "format": "uint",
                                      "minimum": 0,
                                      "type": "integer"
                                    },
                                    "row": {
                                      "format": "uint",
                                      "minimum": 0,
                                      "type": "integer"
                                    },
                                    "rows": {
                                      "format": "uint",
                                      "minimum": 0,
                                      "type": "integer"
                                    }
                                  },
                                  "required": [
                                    "row",
                                    "col",
                                    "rows",
                                    "cols"
                                  ],
                                  "type": "object"
                                },
                                "type": "array"
                              },
                              "row_heights": {
                                "description": "Relative row heights (weights > 0).",
                                "items": {
                                  "format": "double",
                                  "type": "number"
                                },
                                "type": "array"
                              },
                              "stroke_mm": {
                                "default": 0.3,
                                "description": "Grid line width in mm; 0 hides the lines.",
                                "format": "double",
                                "type": "number"
                              },
                              "type": {
                                "const": "table",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "column_widths",
                              "row_heights",
                              "cells",
                              "stroke_mm",
                              "font_family",
                              "font_size_pt",
                              "align"
                            ],
                            "type": "object"
                          },
                          {
                            "description": "A built-in icon from the bundled set (`labely-render` lists the names).",
                            "properties": {
                              "icon": {
                                "description": "Icon name, e.g. `fragile`, `keep_dry`, `this_way_up`, `recycle`.",
                                "type": "string"
                              },
                              "invert": {
                                "type": "boolean"
                              },
                              "keep_aspect": {
                                "default": true,
                                "description": "Keep the icon's aspect ratio inside the frame (default true).",
                                "type": "boolean"
                              },
                              "type": {
                                "const": "icon",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "icon",
                              "keep_aspect"
                            ],
                            "type": "object"
                          },
                          {
                            "description": "A frame drawn just inside the element's box.",
                            "properties": {
                              "corner_radius_mm": {
                                "default": 0.0,
                                "description": "Corner radius in mm (single, double, thick_thin, dashed, dotted).",
                                "format": "double",
                                "type": "number"
                              },
                              "stroke_mm": {
                                "default": 0.5,
                                "description": "Line width in mm.",
                                "format": "double",
                                "type": "number"
                              },
                              "style": {
                                "default": "single",
                                "description": "Decorative frame styles.",
                                "oneOf": [
                                  {
                                    "enum": [
                                      "single",
                                      "double",
                                      "dashed",
                                      "dotted"
                                    ],
                                    "type": "string"
                                  },
                                  {
                                    "const": "thick_thin",
                                    "description": "A thick outer line and a thin inner line.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "corners",
                                    "description": "Corner brackets only.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "ticket",
                                    "description": "Concave (ticket-style) corners.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "scallop",
                                    "description": "Scalloped edge.",
                                    "type": "string"
                                  }
                                ]
                              },
                              "type": {
                                "const": "border",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "style",
                              "stroke_mm",
                              "corner_radius_mm"
                            ],
                            "type": "object"
                          }
                        ],
                        "properties": {
                          "flip_h": {
                            "description": "Mirror left–right inside the frame (before rotation).",
                            "type": "boolean"
                          },
                          "flip_v": {
                            "description": "Mirror top–bottom inside the frame (before rotation).",
                            "type": "boolean"
                          },
                          "group": {
                            "description": "Group id shared by grouped elements (`element.group`); groups are flat.",
                            "format": "uint64",
                            "minimum": 0,
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "height_mm": {
                            "format": "double",
                            "type": "number"
                          },
                          "hidden": {
                            "default": false,
                            "type": "boolean"
                          },
                          "id": {
                            "description": "Stable element id, unique within a document.",
                            "format": "uint64",
                            "minimum": 0,
                            "type": "integer"
                          },
                          "locked": {
                            "default": false,
                            "type": "boolean"
                          },
                          "mirror": {
                            "additionalProperties": false,
                            "description": "Linked mirror copy (`element.mirror`): content, size and position follow the source.",
                            "properties": {
                              "axis": {
                                "description": "Line a mirror copy is reflected across.",
                                "oneOf": [
                                  {
                                    "const": "horizontal",
                                    "description": "Left–right, across the label's vertical centre line.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "vertical",
                                    "description": "Top–bottom, across the label's horizontal centre line.",
                                    "type": "string"
                                  }
                                ]
                              },
                              "of": {
                                "description": "Source element on the same page.",
                                "format": "uint64",
                                "minimum": 0,
                                "type": "integer"
                              }
                            },
                            "required": [
                              "of",
                              "axis"
                            ],
                            "type": [
                              "object",
                              "null"
                            ]
                          },
                          "name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "rotation_deg": {
                            "default": 0.0,
                            "format": "double",
                            "type": "number"
                          },
                          "width_mm": {
                            "format": "double",
                            "type": "number"
                          },
                          "x_mm": {
                            "format": "double",
                            "type": "number"
                          },
                          "y_mm": {
                            "format": "double",
                            "type": "number"
                          }
                        },
                        "required": [
                          "id",
                          "x_mm",
                          "y_mm",
                          "width_mm",
                          "height_mm",
                          "rotation_deg",
                          "locked",
                          "hidden"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "elements"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "serials": {
                "additionalProperties": {
                  "additionalProperties": false,
                  "description": "A serial number: `prefix + pad(start + step × n, digits) + suffix`, where `n` is the\n0-based position of the label in the print job.",
                  "properties": {
                    "digits": {
                      "default": 0,
                      "description": "Minimum digits; shorter numbers are zero-padded. 0 means no padding.",
                      "format": "uint8",
                      "maximum": 255,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "prefix": {
                      "type": "string"
                    },
                    "start": {
                      "default": 1,
                      "format": "int64",
                      "type": "integer"
                    },
                    "step": {
                      "default": 1,
                      "format": "int64",
                      "type": "integer"
                    },
                    "suffix": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "start",
                    "step",
                    "digits"
                  ],
                  "type": "object"
                },
                "description": "Serial counters usable as `{{name}}`; they advance by one step per label (v2).",
                "type": "object"
              },
              "variables": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Free variables usable as `{{name}}` in string properties.",
                "type": "object"
              }
            },
            "required": [
              "format_version",
              "name",
              "label",
              "pages",
              "next_id"
            ],
            "type": "object"
          },
          "path": {
            "description": "File the document was opened from or last saved to.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "doc_id",
          "path",
          "dirty",
          "can_undo",
          "can_redo",
          "document"
        ],
        "title": "GetOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "default": null,
            "description": "Document id; defaults to the active document.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "DocIdParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Change label stock settings; only the given fields change. Sizes in mm. printer_model \"\" and density 0 clear those fields.",
      "id": "doc.set_label",
      "journal": true,
      "kind": "edit",
      "label": "Label settings",
      "menu": "label",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "label": {
            "additionalProperties": false,
            "description": "Physical label stock.",
            "properties": {
              "corner_radius_mm": {
                "default": 0.0,
                "format": "double",
                "type": "number"
              },
              "density": {
                "description": "Preferred density; the model default is used when absent.",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "height_mm": {
                "description": "Length along the feed, mm.",
                "format": "double",
                "type": "number"
              },
              "media": {
                "default": "gap",
                "description": "Media type of the label stock.",
                "enum": [
                  "gap",
                  "black_mark",
                  "continuous",
                  "transparent"
                ],
                "type": "string"
              },
              "printer_model": {
                "description": "Registry id of the intended printer model, e.g. `niimbot.b21_pro`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "width_mm": {
                "description": "Width across the printhead, mm.",
                "format": "double",
                "type": "number"
              }
            },
            "required": [
              "width_mm",
              "height_mm",
              "corner_radius_mm",
              "media"
            ],
            "type": "object"
          }
        },
        "required": [
          "label"
        ],
        "title": "SetLabelOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "corner_radius_mm": {
            "default": null,
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "density": {
            "default": null,
            "description": "Print density; 0 clears it (model default).",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "height_mm": {
            "default": null,
            "description": "Label length along the feed, mm.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "media": {
            "default": null,
            "description": "Media type of the label stock.",
            "enum": [
              "gap",
              "black_mark",
              "continuous",
              "transparent",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "default": null,
            "description": "Document name.",
            "type": [
              "string",
              "null"
            ]
          },
          "printer_model": {
            "default": null,
            "description": "Printer model id; empty string clears it.",
            "type": [
              "string",
              "null"
            ]
          },
          "width_mm": {
            "default": null,
            "description": "Label width across the printhead, mm.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "title": "SetLabelParams",
        "type": "object"
      },
      "undoable": true
    },
    {
      "description": "Turn the label a quarter turn (direction cw or ccw): width and height swap. With rotate_content (default true) every element turns with it about the label, so the design keeps its look; with false the elements stay where they are.",
      "id": "doc.rotate_label",
      "journal": true,
      "kind": "edit",
      "label": "Rotate label paper",
      "menu": "label",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "label": {
            "additionalProperties": false,
            "description": "Physical label stock.",
            "properties": {
              "corner_radius_mm": {
                "default": 0.0,
                "format": "double",
                "type": "number"
              },
              "density": {
                "description": "Preferred density; the model default is used when absent.",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "height_mm": {
                "description": "Length along the feed, mm.",
                "format": "double",
                "type": "number"
              },
              "media": {
                "default": "gap",
                "description": "Media type of the label stock.",
                "enum": [
                  "gap",
                  "black_mark",
                  "continuous",
                  "transparent"
                ],
                "type": "string"
              },
              "printer_model": {
                "description": "Registry id of the intended printer model, e.g. `niimbot.b21_pro`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "width_mm": {
                "description": "Width across the printhead, mm.",
                "format": "double",
                "type": "number"
              }
            },
            "required": [
              "width_mm",
              "height_mm",
              "corner_radius_mm",
              "media"
            ],
            "type": "object"
          }
        },
        "required": [
          "label"
        ],
        "title": "SetLabelOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "direction": {
            "anyOf": [
              {
                "description": "Turn direction for `doc.rotate_label`.",
                "oneOf": [
                  {
                    "const": "cw",
                    "description": "A quarter turn clockwise.",
                    "type": "string"
                  },
                  {
                    "const": "ccw",
                    "description": "A quarter turn anticlockwise.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Quarter-turn direction (default `cw`)."
          },
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "rotate_content": {
            "default": null,
            "description": "Turn the elements with the paper (default true). With false only the label size swaps.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "title": "RotateLabelParams",
        "type": "object"
      },
      "undoable": true
    },
    {
      "description": "List label papers: Labely's bundled sizes (`std:…`) and the user's own (`my:…`), with any RFID barcodes linked to them. Filter by query (id, name, `50x30`, barcode), model (fits the printer's width), media and custom. Sizes in mm.",
      "id": "paper.list",
      "journal": false,
      "kind": "query",
      "label": "Label papers",
      "menu": "label",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "papers": {
            "items": {
              "description": "A paper as listed: the paper plus where it comes from and its linked barcodes.",
              "properties": {
                "barcodes": {
                  "description": "RFID barcodes linked to this paper.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "corner_radius_mm": {
                  "default": 0.0,
                  "format": "double",
                  "type": "number"
                },
                "custom": {
                  "description": "True for the user's own papers (`my:`), false for bundled ones (`std:`).",
                  "type": "boolean"
                },
                "height_mm": {
                  "description": "Length along the feed, mm (the default length for continuous rolls).",
                  "format": "double",
                  "type": "number"
                },
                "id": {
                  "description": "`std:<…>` (bundled) or `my:<…>` (user).",
                  "type": "string"
                },
                "media": {
                  "default": "gap",
                  "description": "Media type of the label stock.",
                  "enum": [
                    "gap",
                    "black_mark",
                    "continuous",
                    "transparent"
                  ],
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "width_mm": {
                  "description": "Width across the printhead, mm.",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "id",
                "name",
                "width_mm",
                "height_mm",
                "corner_radius_mm",
                "media",
                "custom"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "papers"
        ],
        "title": "ListOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "custom": {
            "default": null,
            "description": "Only the user's papers (true) or only bundled ones (false).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "media": {
            "default": null,
            "description": "Media type of the label stock.",
            "enum": [
              "gap",
              "black_mark",
              "continuous",
              "transparent",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "default": null,
            "description": "Only papers that fit this printer model (width ≤ its print width), e.g.\n`niimbot.b21_pro`.",
            "type": [
              "string",
              "null"
            ]
          },
          "query": {
            "default": null,
            "description": "Search in id, name, size (`50x30`) and linked RFID barcodes.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "ListParams",
        "type": "object"
      },
      "undoable": false
    },
