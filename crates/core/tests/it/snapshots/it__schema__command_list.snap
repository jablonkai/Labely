            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "`job-<n>`, unique within the session.",
            "type": "string"
          },
          "labels": {
            "description": "Distinct labels (records or count, times pages).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "model": {
            "description": "Printer model id, when known.",
            "type": [
              "string",
              "null"
            ]
          },
          "pages_done": {
            "description": "Pages printed so far.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "pages_total": {
            "description": "Pages the printer will feed (labels × copies).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "description": "Where a job is.",
            "enum": [
              "queued",
              "printing",
              "done",
              "failed",
              "cancelled"
            ],
            "type": "string"
          },
          "submitted_at": {
            "description": "Local time, `YYYY-MM-DD HH:MM:SS`.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "state",
          "address",
          "doc_name",
          "labels",
          "copies",
          "density",
