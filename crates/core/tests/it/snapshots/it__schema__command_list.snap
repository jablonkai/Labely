    {
      "description": "Render and print at the connected model's dpi: one label per data record (`records` like `1,3,5-7`, default all) or `count` labels without data, with bindings and serials filled in. copies 1–999 (default 1) or per record from `copies_column`; density defaults to the label's, else the model's. Jobs go through the print queue; by default the command waits until the job has printed, `wait: false` returns {job_id} at once. offset_x_mm/offset_y_mm (±10) move the print, mirror flips it for transparent media, rotate_180 turns it for the other output direction. Run doc.check first.",
      "id": "print.submit",
      "journal": false,
      "kind": "device",
      "label": "Print",
      "menu": "print",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "address": {
            "type": "string"
          },
          "copies": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "density": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "dpi": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "duration_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "job_id": {
            "description": "Queue id for job.get, job.wait and job.cancel.",
            "type": "string"
          },
          "labels": {
            "description": "Distinct labels rendered (records or count, times pages).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "pages_printed": {
            "description": "Pages printed so far (0 while queued).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "state": {
            "description": "`done` after a waited print; `queued` or `printing` with `wait: false`.",
            "enum": [
              "queued",
              "printing",
              "done",
              "failed",
              "cancelled"
            ],
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "state",
          "address",
          "labels",
          "pages_printed",
          "duration_ms",
          "copies",
          "density",
          "dpi"
        ],
        "title": "PrintOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "address": {
            "default": null,
            "description": "Printer address; defaults to the single connected printer.",
            "type": [
              "string",
              "null"
            ]
          },
          "copies": {
            "default": null,
            "description": "Number of copies, 1–999 (default 1).",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "copies_column": {
            "default": null,
            "description": "Column holding each record's copy count (0 skips the record); overrides `copies`.",
            "type": [
              "string",
              "null"
            ]
          },
          "count": {
            "default": null,
            "description": "Labels to print without a data source, 1–5000 (default 1); serials advance per label.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "density": {
            "default": null,
            "description": "Print density; defaults to the label's density, else the model default.",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "mirror": {
            "default": null,
            "description": "Mirror the print left to right, for transparent or iron-on media (default false).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "offset_x_mm": {
            "default": null,
            "description": "Move the print right (positive) or left, in mm, −10 to 10 (default 0).",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "offset_y_mm": {
            "default": null,
            "description": "Move the print down (positive, later in the feed) or up, in mm, −10 to 10 (default 0).",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "records": {
            "default": null,
            "description": "Data records to print, 1-based: `all` (default), `3`, `1,4,6-9`. Needs a data source.",
            "type": [
              "string",
              "null"
            ]
          },
          "rotate_180": {
            "default": null,
            "description": "Turn the print 180° so labels leave the printer the other way round (default false).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "wait": {
            "default": null,
            "description": "Wait until the job has printed (default true). With false the job is queued and the\ncommand returns at once; follow it with job.get or job.wait.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "title": "PrintParams",
        "type": "object"
      },
      "shortcut": "Ctrl+P",
      "undoable": false
    },
    {
      "description": "List the print queue: queued, printing and recently finished jobs (oldest first) with progress, plus whether the queue is paused.",
      "id": "job.list",
      "journal": false,
      "kind": "query",
      "label": "Print jobs",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "jobs": {
            "description": "Queued, running and recently finished jobs, oldest first.",
            "items": {
              "description": "A queued, running or finished print job.",
              "properties": {
                "address": {
                  "type": "string"
                },
                "copies": {
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                "density": {
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "doc_name": {
                  "description": "Name of the printed document.",
                  "type": "string"
                },
                "duration_ms": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "error": {
                  "description": "Why the job failed or was cancelled.",
                  "properties": {
                    "accepted": {
                      "description": "Accepted values or nearest valid ids.",
                      "items": {
                        "type": "string"
                      },
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "code": {
                      "description": "Stable error codes (prior-art §4.2 item 9).",
                      "oneOf": [
                        {
                          "enum": [
                            "unknown_command",
                            "bad_params",
                            "disabled",
                            "no_document",
                            "not_found",
                            "device_unavailable",
                            "device_error",
                            "cancelled",
                            "internal"
                          ],
                          "type": "string"
                        },
                        {
                          "const": "forbidden",
                          "description": "Refused by the session policy (file roots, print gating).",
                          "type": "string"
                        }
                      ]
                    },
                    "hint": {
                      "description": "What to do next.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "param": {
                      "description": "Offending param path, e.g. `width_mm` or `props.font_size_pt`.",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "finished_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "id": {
                  "description": "`job-<n>`, unique within the session.",
                  "type": "string"
                },
                "labels": {
                  "description": "Distinct labels (records or count, times pages).",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "model": {
                  "description": "Printer model id, when known.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pages_done": {
                  "description": "Pages printed so far.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "pages_total": {
                  "description": "Pages the printer will feed (labels × copies).",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "started_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "state": {
                  "description": "Where a job is.",
                  "enum": [
                    "queued",
                    "printing",
                    "done",
                    "failed",
                    "cancelled"
                  ],
                  "type": "string"
                },
                "submitted_at": {
                  "description": "Local time, `YYYY-MM-DD HH:MM:SS`.",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "state",
                "address",
                "doc_name",
                "labels",
                "copies",
                "density",
                "pages_total",
                "pages_done",
                "submitted_at"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "paused": {
            "description": "A paused queue starts no new job.",
            "type": "boolean"
          }
        },
        "required": [
          "paused",
          "jobs"
        ],
        "title": "JobListOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Params for commands that take none.",
        "title": "NoParams",
        "type": "object"
      },
      "undoable": false
    },
