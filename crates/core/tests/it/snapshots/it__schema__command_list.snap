        "title": "IdParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Remember that rolls with this RFID barcode are paper `id`, so paper.detect and doc.check recognise them. Replaces an existing link. Not undoable.",
      "id": "paper.link",
