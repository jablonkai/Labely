        ],
        "title": "LinkOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "barcode": {
            "description": "RFID barcode, as reported by device.status or paper.detect.",
            "type": "string"
          },
          "id": {
            "description": "Paper id to link it to (bundled or user).",
            "type": "string"
