    {
      "description": "Merge partial props into an element: frame fields in mm/degrees and the type's own props. Unknown keys and type mismatches are rejected; `type` and `id` cannot change. Returns {element}.",
      "id": "element.set_props",
      "journal": true,
      "kind": "edit",
      "label": "Set properties",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "element": {
            "description": "The element after the change.",
            "oneOf": [
              {
                "properties": {
                  "align": {
                    "default": "left",
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ],
                    "type": "string"
                  },
                  "bold": {
                    "default": false,
                    "type": "boolean"
                  },
                  "direction": {
                    "description": "Horizontal, or vertical: one character per row, top to bottom.",
                    "oneOf": [
                      {
                        "enum": [
                          "horizontal"
                        ],
                        "type": "string"
                      },
                      {
                        "const": "vertical",
                        "description": "Characters stacked top to bottom; each source line is separated by a blank row.",
                        "type": "string"
                      }
                    ]
                  },
                  "fit": {
                    "default": "none",
                    "description": "How text reacts when it does not fit its box.",
                    "oneOf": [
                      {
                        "const": "none",
                        "description": "Keep the size; overflow is reported by `doc.check`.",
                        "type": "string"
                      },
                      {
                        "const": "shrink",
                        "description": "Shrink the font until the text fits.",
                        "type": "string"
                      },
                      {
                        "const": "fill",
                        "description": "Grow or shrink the font to the largest size that fits the box.",
                        "type": "string"
                      }
                    ]
                  },
                  "font_family": {
                    "default": "Noto Sans",
                    "type": "string"
                  },
                  "font_size_pt": {
                    "default": 12.0,
                    "format": "double",
                    "type": "number"
                  },
                  "invert": {
                    "default": false,
                    "description": "White text on black.",
                    "type": "boolean"
                  },
                  "italic": {
                    "default": false,
                    "type": "boolean"
                  },
                  "letter_spacing_mm": {
                    "default": 0.0,
                    "format": "double",
                    "type": "number"
                  },
                  "line_spacing": {
                    "default": 1.0,
                    "description": "Line height multiplier.",
                    "format": "double",
                    "type": "number"
                  },
                  "max_length_mm": {
                    "description": "Warn in `doc.check` when the longest printed line is wider than this, mm.",
                    "format": "double",
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "spans": {
                    "description": "Rich-text style ranges over `text` (horizontal text only). A `{{binding}}` that\ncrosses a span edge is not substituted.",
                    "items": {
                      "additionalProperties": false,
                      "description": "Style for a range of a text element's `text`. Unset fields keep the element's style;\nlater spans win where they overlap.",
                      "properties": {
                        "bold": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "end": {
                          "description": "One past the last character.",
                          "format": "uint",
                          "minimum": 0,
                          "type": "integer"
                        },
                        "font_size_pt": {
                          "format": "double",
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "italic": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "start": {
                          "description": "First character (Unicode scalar index into `text`).",
                          "format": "uint",
                          "minimum": 0,
                          "type": "integer"
                        },
                        "underline": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "start",
                        "end"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "text": {
                    "description": "Text; may contain `{{variable}}` bindings and newlines.",
                    "type": "string"
                  },
                  "type": {
                    "const": "text",
                    "type": "string"
                  },
                  "underline": {
                    "default": false,
                    "type": "boolean"
                  },
                  "valign": {
                    "default": "top",
                    "enum": [
                      "top",
                      "middle",
                      "bottom"
                    ],
                    "type": "string"
                  },
                  "wrap": {
                    "default": true,
                    "type": "boolean"
                  }
                },
                "required": [
