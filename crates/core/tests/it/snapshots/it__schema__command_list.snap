                      "type": "array"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "dpi",
                    "head_dots",
                    "max_width_mm",
                    "density_min",
                    "density_max",
                    "density_default",
                    "media"
                  ],
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "address",
                "name",
                "connected"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "devices"
        ],
        "title": "DevicesOutput",
        "type": "object"
      },
