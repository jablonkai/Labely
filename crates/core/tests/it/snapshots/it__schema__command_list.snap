                  "symbology",
                  "human_readable",
                  "text_size_pt"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "data": {
                    "type": "string"
                  },
                  "ecc": {
                    "default": "M",
                    "description": "QR error-correction level.",
                    "enum": [
                      "L",
                      "M",
                      "Q",
                      "H"
                    ],
                    "type": "string"
                  },
                  "symbology": {
                    "default": "qr",
                    "description": "2D symbologies.",
                    "enum": [
                      "qr",
                      "data_matrix",
                      "pdf417",
                      "aztec"
                    ],
                    "type": "string"
                  },
                  "type": {
                    "const": "code2d",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "data",
                  "symbology",
                  "ecc"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "asset": {
                    "description": "Key into [`Document::assets`].",
                    "type": "string"
                  },
                  "brightness": {
                    "default": 0.0,
                    "description": "-1.0 … 1.0",
                    "format": "double",
                    "type": "number"
                  },
                  "contrast": {
                    "default": 0.0,
                    "description": "-1.0 … 1.0",
                    "format": "double",
                    "type": "number"
                  },
                  "dither": {
                    "default": "floyd_steinberg",
                    "description": "1-bit conversion for images.",
                    "enum": [
                      "threshold",
                      "floyd_steinberg",
                      "atkinson",
                      "bayer"
                    ],
                    "type": "string"
                  },
                  "fit": {
                    "default": "contain",
                    "enum": [
                      "contain",
                      "cover",
                      "stretch"
                    ],
                    "type": "string"
                  },
                  "invert": {
                    "default": false,
                    "type": "boolean"
                  },
                  "threshold": {
                    "default": 128,
                    "description": "0–255 cut-off for `threshold` and the gray point for dithering.",
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "image",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "asset",
                  "fit",
                  "dither",
                  "threshold",
                  "brightness",
                  "contrast",
                  "invert"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "corner_radius_mm": {
                    "default": 0.0,
                    "description": "Rect only.",
                    "format": "double",
                    "type": "number"
                  },
                  "fill": {
                    "default": false,
                    "type": "boolean"
                  },
                  "stroke_mm": {
                    "default": 0.3,
                    "format": "double",
                    "type": "number"
                  },
                  "type": {
                    "const": "rect",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "stroke_mm",
                  "fill",
                  "corner_radius_mm"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "corner_radius_mm": {
                    "default": 0.0,
                    "description": "Rect only.",
                    "format": "double",
                    "type": "number"
                  },
                  "fill": {
                    "default": false,
                    "type": "boolean"
                  },
                  "stroke_mm": {
                    "default": 0.3,
                    "format": "double",
                    "type": "number"
                  },
                  "type": {
                    "const": "ellipse",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "stroke_mm",
                  "fill",
                  "corner_radius_mm"
                ],
                "type": "object"
              },
              {
                "description": "A line from the frame's top-left `(x, y)` to `(x + width, y + height)`.",
                "properties": {
                  "dash_mm": {
                    "description": "Dash and gap length in mm; solid when absent.",
                    "items": {
                      "format": "double",
                      "type": "number"
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "stroke_mm": {
                    "default": 0.3,
                    "format": "double",
                    "type": "number"
                  },
                  "type": {
                    "const": "line",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "stroke_mm"
                ],
                "type": "object"
              }
            ],
            "properties": {
              "height_mm": {
                "format": "double",
                "type": "number"
              },
              "hidden": {
                "default": false,
                "type": "boolean"
              },
              "id": {
                "description": "Stable element id, unique within a document.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "locked": {
                "default": false,
                "type": "boolean"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rotation_deg": {
                "default": 0.0,
                "format": "double",
                "type": "number"
              },
              "width_mm": {
                "format": "double",
                "type": "number"
              },
              "x_mm": {
                "format": "double",
                "type": "number"
              },
              "y_mm": {
                "format": "double",
                "type": "number"
              }
            },
            "required": [
              "id",
              "x_mm",
              "y_mm",
              "width_mm",
              "height_mm",
              "rotation_deg",
              "locked",
              "hidden"
            ],
            "type": "object"
          }
        },
        "required": [
          "element"
        ],
        "title": "ElementOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Stable element id, unique within a document.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "rotation_deg": {
            "description": "Absolute clockwise rotation about the frame centre, degrees; normalised to 0–360.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "id",
          "rotation_deg"
        ],
        "title": "RotateParams",
        "type": "object"
      },
      "undoable": true
    },
