                      {
                        "const": "none",
                        "description": "Keep the size; overflow is reported by `doc.check`.",
                        "type": "string"
                      },
                      {
                        "const": "shrink",
                        "description": "Shrink the font until the text fits.",
                        "type": "string"
                      }
                    ]
                  },
                  "font_family": {
                    "default": "Noto Sans",
                    "type": "string"
                  },
                  "font_size_pt": {
                    "default": 12.0,
                    "format": "double",
                    "type": "number"
                  },
                  "invert": {
                    "default": false,
                    "description": "White text on black.",
                    "type": "boolean"
                  },
                  "italic": {
                    "default": false,
                    "type": "boolean"
                  },
                  "letter_spacing_mm": {
                    "default": 0.0,
                    "format": "double",
                    "type": "number"
                  },
                  "line_spacing": {
                    "default": 1.0,
                    "description": "Line height multiplier.",
                    "format": "double",
                    "type": "number"
                  },
                  "text": {
                    "description": "Text; may contain `{{variable}}` bindings and newlines.",
                    "type": "string"
                  },
                  "type": {
                    "const": "text",
                    "type": "string"
                  },
                  "underline": {
                    "default": false,
                    "type": "boolean"
                  },
                  "valign": {
                    "default": "top",
                    "enum": [
                      "top",
                      "middle",
                      "bottom"
                    ],
                    "type": "string"
                  },
                  "wrap": {
                    "default": true,
                    "type": "boolean"
                  }
                },
