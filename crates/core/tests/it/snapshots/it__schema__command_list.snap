    },
    {
      "description": "Read battery %, lid, paper presence and RFID paper info (default: the single connected printer).",
      "id": "device.status",
      "journal": false,
      "kind": "device",
      "label": "Printer status",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
