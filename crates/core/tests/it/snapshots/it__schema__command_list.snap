    {
      "description": "Columns, record count and a page of rows of the data source (from 1-based, limit ≤ 200), plus the serial counters.",
      "id": "data.get",
      "journal": false,
      "kind": "query",
      "label": "Get data",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "attached": {
            "description": "False when no data source is attached; the other fields are then empty.",
            "type": "boolean"
          },
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "from": {
            "description": "1-based number of the first returned row.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "origin": {
            "type": [
              "string",
              "null"
            ]
          },
          "row_count": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "rows": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "serials": {
            "additionalProperties": {
              "additionalProperties": false,
              "description": "A serial number: `prefix + pad(start + step × n, digits) + suffix`, where `n` is the\n0-based position of the label in the print job.",
              "properties": {
                "digits": {
                  "default": 0,
                  "description": "Minimum digits; shorter numbers are zero-padded. 0 means no padding.",
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "prefix": {
                  "type": "string"
                },
                "start": {
                  "default": 1,
                  "format": "int64",
                  "type": "integer"
                },
                "step": {
                  "default": 1,
                  "format": "int64",
                  "type": "integer"
                },
                "suffix": {
                  "type": "string"
                }
              },
              "required": [
                "start",
                "step",
                "digits"
              ],
              "type": "object"
            },
            "description": "Serial counters by name.",
            "type": "object"
          }
        },
        "required": [
          "attached",
          "columns",
          "row_count",
          "from",
          "rows",
          "serials"
        ],
        "title": "GetOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "from": {
            "default": null,
            "description": "First record to return, 1-based (default 1).",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "limit": {
            "default": null,
            "description": "Records to return, 0–200 (default 20).",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "title": "GetParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Set a text element's `text`, or a barcode or 2D code's `data`, to `{{column}}`. The name must be a data column, serial or variable. For mixed content, use element.set_props with `{{name}}` inside the string.",
