    {
      "description": "Find print problems. Rules: out_of_bounds, in_margin (with margin_mm), outside_printable, label_too_wide, dpi_mismatch, density_out_of_range, paper_mismatch (the printer's RFID paper: size when the barcode is linked in the paper library, else media), binding_missing, binding_empty, render_failed, text_overflow, text_shrunk (< 5 pt is a warning), encode_failed, module_too_narrow (< 2 dots), quiet_zone, code_unreadable (render, decode, compare), bad_asset, font_fallback, low_contrast. Returns {ok, dpi, issues:[{rule, severity, element_id?, message, hint}]}; ok is false when any issue has severity error.",
      "id": "doc.check",
      "journal": false,
      "kind": "query",
      "label": "Check document",
      "menu": "label",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "dpi": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "issues": {
            "items": {
              "description": "One `doc.check` finding.",
              "properties": {
                "element_id": {
                  "description": "Stable element id, unique within a document.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "hint": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "rule": {
                  "description": "Rule id, e.g. `out_of_bounds`, `text_overflow`, `code_unreadable`.",
                  "type": "string"
                },
                "severity": {
                  "description": "How serious a check finding is.",
                  "enum": [
                    "info",
                    "warning",
                    "error"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "rule",
                "severity",
                "message",
                "hint"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "ok": {
            "description": "True when there are no `error` issues.",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "dpi",
          "issues"
        ],
        "title": "CheckOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "address": {
            "default": null,
            "description": "Printer whose loaded paper (RFID) is compared with the label. Defaults to the only\nconnected printer, if exactly one is connected.",
            "type": [
              "string",
              "null"
            ]
          },
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "dpi": {
            "default": null,
            "description": "Check resolution in dpi; defaults to the label's printer model dpi, else 203.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "margin_mm": {
            "default": null,
            "description": "Safe margin from the label edge in mm; elements inside it are reported. Default 0.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "title": "CheckParams",
        "type": "object"
      },
      "shortcut": "Ctrl+K",
      "undoable": false
    },
    {
      "description": "Add a text box. Frame in mm (x_mm, y_mm = top-left; width_mm, height_mm), rotation_deg clockwise; font_size_pt in points. `{{name}}` binds a data column, serial or variable; `{{now:%d.%m.%Y}}` or `{{now+30d}}` prints the date. Returns {id}.",
      "id": "element.add_text",
      "journal": true,
      "kind": "edit",
      "label": "Add text",
      "menu": "insert",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "description": "Id of the new element.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "title": "AddOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "align": {
            "default": null,
            "enum": [
              "left",
              "center",
              "right",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "bold": {
            "default": null,
            "type": [
              "boolean",
              "null"
            ]
          },
          "direction": {
            "anyOf": [
              {
                "description": "Text flow. Text turned 90° is `rotation_deg: 90`; curved text is planned for Phase 6.",
                "oneOf": [
                  {
                    "enum": [
                      "horizontal"
                    ],
                    "type": "string"
                  },
                  {
                    "const": "vertical",
                    "description": "Characters stacked top to bottom; each source line is separated by a blank row.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "`horizontal` (default) or `vertical` (characters stacked top to bottom)."
          },
          "doc_id": {
            "default": null,
            "description": "Document id; defaults to the active document.",
            "type": [
              "string",
              "null"
            ]
          },
          "fit": {
            "anyOf": [
              {
                "description": "How text reacts when it does not fit its box.",
                "oneOf": [
                  {
                    "const": "none",
                    "description": "Keep the size; overflow is reported by `doc.check`.",
                    "type": "string"
                  },
                  {
                    "const": "shrink",
                    "description": "Shrink the font until the text fits.",
                    "type": "string"
                  },
                  {
                    "const": "fill",
                    "description": "Grow or shrink the font to the largest size that fits the box.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "`none` (default; overflow reported by doc.check), `shrink` (smaller until it fits)\nor `fill` (the largest size that fits the box)."
          },
          "font_family": {
            "default": null,
            "description": "Font family (default `Noto Sans`).",
            "type": [
              "string",
              "null"
            ]
          },
          "font_size_pt": {
            "default": null,
            "description": "Font size in points (default 12).",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "height_mm": {
            "description": "Frame height, mm.",
            "format": "double",
            "type": "number"
          },
          "invert": {
            "default": null,
            "description": "White text on black.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "italic": {
            "default": null,
            "type": [
              "boolean",
              "null"
            ]
          },
          "letter_spacing_mm": {
            "default": null,
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "line_spacing": {
            "default": null,
            "description": "Line height multiplier (default 1.0).",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "max_length_mm": {
            "default": null,
            "description": "doc.check warns when the longest printed line is wider than this, mm.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "name": {
            "default": null,
            "description": "Optional element name.",
            "type": [
              "string",
              "null"
            ]
          },
          "rotation_deg": {
            "default": null,
            "description": "Clockwise rotation about the frame centre, degrees (default 0).",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "text": {
            "description": "Text; may contain `{{variable}}` bindings and newlines.",
            "type": "string"
          },
          "underline": {
            "default": null,
            "type": [
              "boolean",
              "null"
            ]
          },
          "valign": {
            "default": null,
            "enum": [
              "top",
              "middle",
              "bottom",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "width_mm": {
            "description": "Frame width, mm.",
            "format": "double",
            "type": "number"
          },
          "wrap": {
            "default": null,
            "description": "Wrap at the frame width (default true).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "x_mm": {
            "description": "Left edge of the unrotated frame, mm from the label's left edge.",
            "format": "double",
            "type": "number"
          },
          "y_mm": {
            "description": "Top edge of the unrotated frame, mm from the label's top edge.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "x_mm",
          "y_mm",
          "width_mm",
          "height_mm",
          "text"
        ],
        "title": "TextParams",
        "type": "object"
      },
      "shortcut": "T",
      "undoable": true
    },
    {
      "description": "Add a 1D barcode. Frame in mm; text_size_pt in points. Returns {id}.",
      "id": "element.add_barcode",
      "journal": true,
      "kind": "edit",
      "label": "Add barcode",
      "menu": "insert",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "description": "Id of the new element.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "title": "AddOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "data": {
            "description": "Data to encode; may contain `{{variable}}` bindings.",
            "type": "string"
          },
          "doc_id": {
            "default": null,
            "description": "Document id; defaults to the active document.",
            "type": [
              "string",
              "null"
            ]
          },
          "height_mm": {
            "description": "Frame height, mm.",
            "format": "double",
            "type": "number"
          },
          "human_readable": {
            "default": null,
            "description": "Human-readable text position (default `below`).",
            "enum": [
              "none",
              "below",
              "above",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "default": null,
            "description": "Optional element name.",
            "type": [
              "string",
              "null"
            ]
          },
          "rotation_deg": {
            "default": null,
            "description": "Clockwise rotation about the frame centre, degrees (default 0).",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "symbology": {
            "anyOf": [
              {
                "description": "1D symbologies.",
                "oneOf": [
                  {
                    "enum": [
                      "code39",
                      "code93",
                      "ean13",
                      "ean8",
                      "upc_a",
                      "upc_e",
                      "itf",
                      "codabar"
                    ],
                    "type": "string"
                  },
                  {
                    "const": "code128",
                    "description": "Code 128, code set chosen automatically.",
                    "type": "string"
                  },
                  {
                    "const": "code128_a",
                    "description": "Code 128 forced to code set A (upper case, digits, control characters).",
                    "type": "string"
                  },
                  {
                    "const": "code128_b",
                    "description": "Code 128 forced to code set B (printable ASCII).",
                    "type": "string"
                  },
                  {
                    "const": "code128_c",
                    "description": "Code 128 forced to code set C (an even number of digits).",
                    "type": "string"
                  },
                  {
                    "const": "gs1_128",
                    "description": "GS1-128: application identifiers in brackets, e.g. `(01)09501101530003(17)250101`.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "1D symbology (default `code128`)."
          },
          "text_size_pt": {
            "default": null,
            "description": "Human-readable text size in points (default 8).",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "width_mm": {
            "description": "Frame width, mm.",
            "format": "double",
            "type": "number"
          },
          "x_mm": {
            "description": "Left edge of the unrotated frame, mm from the label's left edge.",
            "format": "double",
            "type": "number"
          },
          "y_mm": {
            "description": "Top edge of the unrotated frame, mm from the label's top edge.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "x_mm",
          "y_mm",
          "width_mm",
          "height_mm",
          "data"
        ],
        "title": "BarcodeParams",
        "type": "object"
      },
      "shortcut": "B",
      "undoable": true
    },
