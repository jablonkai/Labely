    {
      "description": "Change z-order: front, back, forward (one up) or backward (one down).",
      "id": "element.reorder",
      "journal": true,
      "kind": "edit",
      "label": "Reorder",
      "menu": "arrange",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "index": {
            "description": "New z-index on the page (0 = bottom).",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "index"
        ],
        "title": "ReorderOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Stable element id, unique within a document.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "to": {
            "description": "Z-order target.",
            "oneOf": [
              {
                "const": "front",
                "description": "On top of everything.",
                "type": "string"
              },
              {
                "const": "back",
                "description": "Below everything.",
                "type": "string"
              },
              {
                "const": "forward",
                "description": "One step up.",
                "type": "string"
              },
              {
                "const": "backward",
                "description": "One step down.",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "id",
          "to"
        ],
        "title": "ReorderParams",
        "type": "object"
      },
      "undoable": true
    },
    {
      "description": "Align elements' rotated bounding boxes on an edge or centre line (left, center, right, top, middle, bottom) of their common box (`to: selection`, the default for 2+ ids) or of the label. Locked elements stay put. Returns {moved}.",
      "id": "element.align",
      "journal": true,
      "kind": "edit",
      "label": "Align",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "moved": {
            "description": "Elements whose position changed.",
            "items": {
              "description": "Stable element id, unique within a document.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "moved"
        ],
        "title": "MovedOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "edge": {
            "description": "Edge or centre line to align on.",
            "oneOf": [
              {
                "enum": [
                  "left",
                  "right",
                  "top",
                  "bottom"
                ],
                "type": "string"
              },
              {
                "const": "center",
                "description": "Horizontal centres.",
                "type": "string"
              },
              {
                "const": "middle",
                "description": "Vertical centres.",
                "type": "string"
              }
            ]
          },
          "ids": {
            "items": {
              "description": "Stable element id, unique within a document.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "to": {
            "anyOf": [
              {
                "description": "What `element.align` aligns to.",
                "oneOf": [
                  {
                    "const": "selection",
                    "description": "The bounding box of the given elements.",
                    "type": "string"
                  },
                  {
                    "const": "label",
                    "description": "The label.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Default: `selection` for two or more elements, `label` for one."
          }
        },
        "required": [
          "ids",
          "edge"
        ],
        "title": "AlignParams",
        "type": "object"
      },
      "undoable": true
    },
    {
      "description": "Space 3+ elements evenly along an axis: the outermost stay, the others move so the gaps between their bounding boxes are equal. Returns {moved}.",
      "id": "element.distribute",
      "journal": true,
      "kind": "edit",
      "label": "Distribute",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "moved": {
            "description": "Elements whose position changed.",
            "items": {
              "description": "Stable element id, unique within a document.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "moved"
        ],
        "title": "MovedOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "axis": {
            "enum": [
              "horizontal",
              "vertical"
            ],
            "type": "string"
          },
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "ids": {
            "description": "Three or more elements.",
            "items": {
              "description": "Stable element id, unique within a document.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "ids",
          "axis"
        ],
        "title": "DistributeParams",
        "type": "object"
      },
      "undoable": true
    },
