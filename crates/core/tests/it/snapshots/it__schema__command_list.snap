      },
      "undoable": false
    },
    {
      "description": "Read the loaded roll's RFID tag and look its barcode up in the paper library. Returns {rfid, barcode, media, remaining, paper?, matches_label?}. When paper is found and matches_label is false, paper.apply {id} sets the label to it. An unknown barcode can be linked with paper.link.",
      "id": "paper.detect",
      "journal": false,
      "kind": "device",
      "label": "Detect label paper",
      "menu": "print",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "address": {
            "type": "string"
          },
          "barcode": {
            "type": [
              "string",
              "null"
            ]
          },
          "matches_label": {
            "description": "Whether the document's label matches the paper (size and media), or only the media\nwhen the paper is unknown. Absent without a document or tag.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "media": {
            "description": "Media type the tag reports.",
            "enum": [
              "gap",
              "black_mark",
              "continuous",
              "transparent",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "paper": {
            "description": "The linked paper; absent when the barcode is not linked yet (use paper.link).",
            "properties": {
              "barcodes": {
                "description": "RFID barcodes linked to this paper.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "corner_radius_mm": {
                "default": 0.0,
                "format": "double",
                "type": "number"
              },
              "custom": {
                "description": "True for the user's own papers (`my:`), false for bundled ones (`std:`).",
                "type": "boolean"
              },
              "height_mm": {
                "description": "Length along the feed, mm (the default length for continuous rolls).",
                "format": "double",
                "type": "number"
              },
              "id": {
                "description": "`std:<…>` (bundled) or `my:<…>` (user).",
                "type": "string"
              },
              "media": {
                "default": "gap",
                "description": "Media type of the label stock.",
                "enum": [
                  "gap",
                  "black_mark",
                  "continuous",
                  "transparent"
                ],
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "width_mm": {
                "description": "Width across the printhead, mm.",
                "format": "double",
                "type": "number"
              }
            },
            "required": [
              "id",
              "name",
              "width_mm",
              "height_mm",
              "corner_radius_mm",
              "media",
              "custom"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "remaining": {
            "description": "Labels left on the roll (total − used), as the tag reports it.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "rfid": {
            "description": "False when the printer reported no RFID tag (no paper, or paper without a tag).",
            "type": "boolean"
          }
        },
        "required": [
          "address",
          "rfid"
        ],
        "title": "DetectOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "address": {
            "default": null,
            "description": "Printer address; defaults to the single connected printer.",
            "type": [
              "string",
              "null"
            ]
          },
          "doc_id": {
            "default": null,
            "description": "Document to compare with (default: the active one, if any).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "DetectParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Calibrate the printer's label sensor: it feeds labels until it finds a label edge (gap or black mark). Run it after loading a new kind of paper when labels print out of position. media defaults to the active label's. Feeds paper, so it needs print permission like print.submit.",
      "id": "device.calibrate",
