            "type": "string"
          },
          "status": {
            "description": "Live device status.",
            "properties": {
              "battery_percent": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "lid_closed": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "paper": {
                "description": "Label stock reported by the printer (RFID).",
                "properties": {
                  "barcode": {
                    "type": "string"
                  },
                  "media": {
                    "description": "Media type of the label stock.",
                    "enum": [
                      "gap",
                      "black_mark",
                      "continuous",
                      "transparent",
                      null
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "serial": {
                    "type": "string"
                  },
                  "total": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "used": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "barcode",
                  "serial",
                  "total",
                  "used"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "paper_present": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
