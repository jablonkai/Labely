            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "ids": {
            "description": "Element ids; `[]` with mode `replace` clears the selection.",
            "items": {
              "description": "Stable element id, unique within a document.",
              "format": "uint64",
