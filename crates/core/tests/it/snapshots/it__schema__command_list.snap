              "string",
              "null"
            ]
          },
          "name": {
            "default": null,
            "description": "Optional element name.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "default": null,
            "description": "Image file to embed (PNG, JPEG, BMP, WebP). Exactly one of `path` / `data_base64`.",
            "type": [
              "string",
              "null"
            ]
          },
          "rotation_deg": {
            "default": null,
