              "null"
            ]
          },
          "media": {
            "default": null,
            "description": "Paper type to calibrate for; defaults to the active document's label media, else gap.",
            "enum": [
              "gap",
              "black_mark",
              "continuous",
              "transparent",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "CalibrateParams",
        "type": "object"
      },
      "undoable": false
    },
    {
