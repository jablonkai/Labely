    {
      "description": "The session's successful edit commands as [{id, params}], oldest first. The list is a script: pass it as command.batch steps or to `labely run --script` to replay.",
      "id": "history.journal",
      "journal": false,
      "kind": "query",
      "label": "Journal",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "entries": {
            "description": "Entries from `since` on; replay them in order with `command.batch` or\n`labely run --script`.",
            "items": {
              "properties": {
                "id": {
                  "type": "string"
                },
                "params": true
              },
              "required": [
                "id",
                "params"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "total": {
            "description": "Number of entries recorded so far.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "total",
          "entries"
        ],
        "title": "JournalOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "since": {
            "default": 0,
            "description": "Skip the first `since` entries (for incremental reads). Default 0.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "title": "JournalParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Set the selected elements of a document (default: active). mode: replace (default), add, remove or toggle. Not undoable.",
      "id": "selection.set",
