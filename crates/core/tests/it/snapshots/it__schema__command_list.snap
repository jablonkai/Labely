---
source: crates/core/tests/it/schema.rs
expression: r
---
{
  "api_version": 3,
  "commands": [
    {
      "description": "List every command with its kind, description and JSON Schemas for params and result. Optional `prefix` filters ids (e.g. `element.`).",
      "id": "command.list",
      "journal": false,
      "kind": "query",
      "label": "List commands",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "api_version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "commands": {
            "items": {
              "description": "Listing entry returned by `command.list`.",
              "properties": {
                "description": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "journal": {
                  "type": "boolean"
                },
                "kind": {
                  "description": "What a command does; decides undo and batch behaviour.",
                  "oneOf": [
                    {
                      "const": "query",
                      "description": "Reads state; pushes no undo step.",
                      "type": "string"
                    },
                    {
                      "const": "edit",
                      "description": "Changes a document; one undo step when `undoable`.",
                      "type": "string"
                    },
                    {
                      "const": "device",
                      "description": "Talks to a printer; pushes no undo step and is refused inside atomic batches.",
                      "type": "string"
                    },
                    {
                      "const": "ui",
                      "description": "Changes view state only (selection, zoom, panels); never touches a document.",
                      "type": "string"
                    }
                  ]
                },
                "label": {
                  "type": "string"
                },
                "menu": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "output_schema": {
                  "description": "JSON Schema of `result`."
                },
                "params_schema": {
                  "description": "JSON Schema (2020-12, refs inlined) of the params object."
                },
                "shortcut": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "undoable": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "label",
                "description",
                "kind",
                "journal",
                "undoable",
                "params_schema",
                "output_schema"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "envelope_params": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Params accepted by every command in addition to its own.",
            "type": "object"
          }
        },
        "required": [
          "api_version",
          "commands",
          "envelope_params"
        ],
        "title": "ListOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "prefix": {
            "default": null,
            "description": "Only list ids starting with this prefix, e.g. `element.`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "ListParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Run several commands as one. Params: steps [{id, params}], atomic (default true: all or nothing, one undo step), stop_on_error (default true), label, terse. A param string that is exactly `$N`, `$N.path` or `$last.path` takes a value from an earlier step's result, e.g. `$0.id` or `$1.created.0`; `$$` escapes a literal `$`. Max 128 steps.",
      "id": "command.batch",
      "journal": false,
      "kind": "edit",
      "label": "Run batch",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "completed": {
            "description": "Steps that succeeded.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "created": {
            "description": "Elements created by all steps.",
            "items": {
              "description": "Stable element id, unique within a document.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "failed": {
            "description": "Steps that failed (only non-zero when `atomic` is false).",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "results": {
            "items": {
              "properties": {
                "error": {
                  "description": "A command failure; serialised as the envelope's `error` object.",
                  "properties": {
                    "accepted": {
                      "description": "Accepted values or nearest valid ids.",
                      "items": {
                        "type": "string"
                      },
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "code": {
                      "description": "Stable error codes (prior-art §4.2 item 9).",
                      "oneOf": [
                        {
                          "enum": [
                            "unknown_command",
                            "bad_params",
                            "disabled",
                            "no_document",
                            "not_found",
                            "device_unavailable",
                            "device_error",
                            "cancelled",
                            "internal"
                          ],
                          "type": "string"
                        },
                        {
                          "const": "forbidden",
                          "description": "Refused by the session policy (file roots, print gating).",
                          "type": "string"
                        }
                      ]
                    },
                    "hint": {
                      "description": "What to do next.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "param": {
                      "description": "Offending param path, e.g. `width_mm` or `props.font_size_pt`.",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "ok": {
                  "type": "boolean"
                },
                "result": true
              },
              "required": [
                "ok"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "completed",
          "failed",
          "results",
          "created"
        ],
        "title": "BatchOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "atomic": {
            "default": true,
            "description": "All or nothing (default true): any failure restores the state from before the batch,\nand success is one undo step. `print.*`, `device.*`, `doc.open`, `doc.close`,\n`history.*` and nested batches are refused.",
            "type": "boolean"
          },
          "label": {
            "default": null,
            "description": "Undo step label (default `command.batch`).",
            "type": [
              "string",
              "null"
            ]
          },
          "steps": {
            "description": "Steps to run in order (max 128).",
            "items": {
              "additionalProperties": false,
              "description": "One step: a command id and its params.",
              "properties": {
                "id": {
                  "description": "Command id, e.g. `element.add_text`.",
                  "type": "string"
                },
                "params": {
                  "default": null,
                  "description": "Params object. A string that is exactly `$N`, `$N.path` or `$last.path` is replaced by a\nvalue from an earlier step's result (`$0.id`, `$1.created.0`); `$$…` is a literal `$…`."
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "stop_on_error": {
            "default": true,
            "description": "Stop at the first failed step (default true; always true when atomic).",
            "type": "boolean"
          },
          "terse": {
            "default": false,
            "description": "Omit per-step `result` from the reply.",
            "type": "boolean"
          }
        },
        "required": [
          "steps"
        ],
        "title": "BatchParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Create an empty label document and make it active. Sizes in mm (width across the printhead, height along the feed). Returns {doc_id}.",
      "id": "doc.new",
      "journal": true,
      "kind": "edit",
      "label": "New document",
      "menu": "file",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "doc_id": {
            "description": "Id of the document, usable as `doc_id` in other commands.",
            "type": "string"
          }
        },
        "required": [
          "doc_id"
        ],
        "title": "DocIdOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "corner_radius_mm": {
            "default": null,
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "density": {
            "default": null,
            "description": "Print density; the model default is used when absent.",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "height_mm": {
            "description": "Label length along the feed, mm.",
            "format": "double",
            "type": "number"
          },
          "media": {
            "default": null,
            "description": "Label stock (default `gap`).",
            "enum": [
              "gap",
              "black_mark",
              "continuous",
              "transparent",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "default": null,
            "description": "Document name (default `Untitled`).",
            "type": [
              "string",
              "null"
            ]
          },
          "printer_model": {
            "default": null,
            "description": "Printer model id, e.g. `niimbot.b21_pro`; sets the preview/check dpi.",
            "type": [
              "string",
              "null"
            ]
          },
          "width_mm": {
            "description": "Label width across the printhead, mm.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "width_mm",
          "height_mm"
        ],
        "title": "NewParams",
        "type": "object"
      },
      "shortcut": "Ctrl+N",
      "undoable": true
    },
    {
      "description": "Open a `.labely` file as a new document and make it active. Returns {doc_id, name}.",
      "id": "doc.open",
      "journal": true,
      "kind": "edit",
      "label": "Open document",
      "menu": "file",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "doc_id",
          "name"
        ],
        "title": "OpenOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Path of a `.labely` file.",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "OpenParams",
        "type": "object"
      },
      "shortcut": "Ctrl+O",
      "undoable": false
    },
    {
      "description": "Write the document as pretty `.labely` JSON. `path` defaults to the file it was opened from or last saved to.",
      "id": "doc.save",
      "journal": false,
      "kind": "query",
      "label": "Save document",
      "menu": "file",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "bytes": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes"
        ],
        "title": "SaveOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "default": null,
            "description": "Target path; defaults to where the document was opened or last saved.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "SaveParams",
        "type": "object"
      },
      "shortcut": "Ctrl+S",
      "undoable": false
    },
    {
      "description": "Close a document (default: active) and drop its history. Unsaved changes are lost; a warning says so.",
      "id": "doc.close",
      "journal": true,
      "kind": "edit",
      "label": "Close document",
      "menu": "file",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "active": {
            "description": "The new active document, if any remain open.",
            "type": [
              "string",
              "null"
            ]
          },
          "closed": {
            "type": "string"
          }
        },
        "required": [
          "closed",
          "active"
        ],
        "title": "CloseOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "default": null,
            "description": "Document id; defaults to the active document.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "DocIdParams",
        "type": "object"
      },
      "shortcut": "Ctrl+W",
      "undoable": false
    },
    {
      "description": "Return the full document JSON (units mm, elements with ids) plus doc_id, path, dirty and undo/redo availability.",
      "id": "doc.get",
      "journal": false,
      "kind": "query",
      "label": "Get document",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "can_redo": {
            "type": "boolean"
          },
          "can_undo": {
            "type": "boolean"
          },
          "dirty": {
            "description": "Changed since the last open/save (always true for never-saved documents).",
            "type": "boolean"
          },
          "doc_id": {
            "type": "string"
          },
          "document": {
            "additionalProperties": false,
            "description": "The full `.labely` document. Units are mm.",
            "properties": {
              "assets": {
                "additionalProperties": {
                  "additionalProperties": false,
                  "description": "Embedded binary asset.",
                  "properties": {
                    "data_base64": {
                      "description": "Standard base64 of the bytes.",
                      "type": "string"
                    },
                    "mime": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "mime",
                    "data_base64"
                  ],
                  "type": "object"
                },
                "description": "Embedded assets keyed by lowercase hex sha256 of the bytes.",
                "type": "object"
              },
              "data": {
                "additionalProperties": false,
                "description": "Attached data source; each row is one record, printed as one label (v2).",
                "properties": {
                  "columns": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "origin": {
                    "description": "File name the data came from, for display only.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rows": {
                    "description": "Rows of cells; a short row reads as empty cells.",
                    "items": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "columns",
                  "rows"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "format_version": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "label": {
                "additionalProperties": false,
                "description": "Physical label stock.",
                "properties": {
                  "corner_radius_mm": {
                    "default": 0.0,
                    "format": "double",
                    "type": "number"
                  },
                  "density": {
                    "description": "Preferred density; the model default is used when absent.",
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "height_mm": {
                    "description": "Length along the feed, mm.",
                    "format": "double",
                    "type": "number"
                  },
                  "media": {
                    "default": "gap",
                    "description": "Media type of the label stock.",
                    "enum": [
                      "gap",
                      "black_mark",
                      "continuous",
                      "transparent"
                    ],
                    "type": "string"
                  },
                  "printer_model": {
                    "description": "Registry id of the intended printer model, e.g. `niimbot.b21_pro`.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "width_mm": {
                    "description": "Width across the printhead, mm.",
                    "format": "double",
                    "type": "number"
                  }
                },
                "required": [
                  "width_mm",
                  "height_mm",
                  "corner_radius_mm",
                  "media"
                ],
                "type": "object"
              },
              "name": {
                "type": "string"
              },
              "next_id": {
                "description": "Next id to hand out.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "pages": {
                "description": "Pages; Phase 1 documents have exactly one.",
                "items": {
                  "additionalProperties": false,
                  "description": "One printed page.",
                  "properties": {
                    "elements": {
                      "description": "Z-order: later elements draw on top.",
                      "items": {
                        "description": "A positioned element. The frame is the unrotated box; rotation is about its centre.",
                        "oneOf": [
                          {
                            "properties": {
                              "align": {
                                "default": "left",
                                "enum": [
                                  "left",
                                  "center",
                                  "right"
                                ],
                                "type": "string"
                              },
                              "bold": {
                                "default": false,
                                "type": "boolean"
                              },
                              "fit": {
                                "default": "none",
                                "description": "How text reacts when it does not fit its box.",
                                "oneOf": [
                                  {
                                    "const": "none",
                                    "description": "Keep the size; overflow is reported by `doc.check`.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "shrink",
                                    "description": "Shrink the font until the text fits.",
                                    "type": "string"
                                  }
                                ]
                              },
                              "font_family": {
                                "default": "Noto Sans",
                                "type": "string"
                              },
                              "font_size_pt": {
                                "default": 12.0,
                                "format": "double",
                                "type": "number"
                              },
                              "invert": {
                                "default": false,
                                "description": "White text on black.",
                                "type": "boolean"
                              },
                              "italic": {
                                "default": false,
                                "type": "boolean"
                              },
                              "letter_spacing_mm": {
                                "default": 0.0,
                                "format": "double",
                                "type": "number"
                              },
                              "line_spacing": {
                                "default": 1.0,
                                "description": "Line height multiplier.",
                                "format": "double",
                                "type": "number"
                              },
                              "text": {
                                "description": "Text; may contain `{{variable}}` bindings and newlines.",
                                "type": "string"
                              },
                              "type": {
                                "const": "text",
                                "type": "string"
                              },
                              "underline": {
                                "default": false,
                                "type": "boolean"
                              },
                              "valign": {
                                "default": "top",
                                "enum": [
                                  "top",
                                  "middle",
                                  "bottom"
                                ],
                                "type": "string"
                              },
                              "wrap": {
                                "default": true,
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "type",
                              "text",
                              "font_family",
                              "font_size_pt",
                              "bold",
                              "italic",
                              "underline",
                              "align",
                              "valign",
                              "line_spacing",
                              "letter_spacing_mm",
                              "wrap",
                              "fit",
                              "invert"
                            ],
                            "type": "object"
                          },
                          {
                            "properties": {
                              "data": {
                                "type": "string"
                              },
                              "human_readable": {
                                "default": "below",
                                "enum": [
                                  "none",
                                  "below",
                                  "above"
                                ],
                                "type": "string"
                              },
                              "symbology": {
                                "default": "code128",
                                "description": "1D symbologies.",
                                "enum": [
                                  "code128",
                                  "code39",
                                  "code93",
                                  "ean13",
                                  "ean8",
                                  "upc_a",
                                  "upc_e",
                                  "itf",
                                  "codabar"
                                ],
                                "type": "string"
                              },
                              "text_size_pt": {
                                "default": 8.0,
                                "format": "double",
                                "type": "number"
                              },
                              "type": {
                                "const": "barcode",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "data",
                              "symbology",
                              "human_readable",
                              "text_size_pt"
                            ],
                            "type": "object"
                          },
                          {
                            "properties": {
                              "data": {
                                "type": "string"
                              },
                              "ecc": {
                                "default": "M",
                                "description": "QR error-correction level.",
                                "enum": [
                                  "L",
                                  "M",
                                  "Q",
                                  "H"
                                ],
                                "type": "string"
                              },
                              "symbology": {
                                "default": "qr",
                                "description": "2D symbologies.",
                                "enum": [
                                  "qr",
                                  "data_matrix",
                                  "pdf417",
                                  "aztec"
                                ],
                                "type": "string"
                              },
                              "type": {
                                "const": "code2d",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "data",
                              "symbology",
                              "ecc"
                            ],
                            "type": "object"
                          },
                          {
                            "properties": {
                              "asset": {
                                "description": "Key into [`Document::assets`].",
                                "type": "string"
                              },
                              "brightness": {
                                "default": 0.0,
                                "description": "-1.0 … 1.0",
                                "format": "double",
                                "type": "number"
                              },
                              "contrast": {
                                "default": 0.0,
                                "description": "-1.0 … 1.0",
                                "format": "double",
                                "type": "number"
                              },
                              "dither": {
                                "default": "floyd_steinberg",
                                "description": "1-bit conversion for images.",
                                "enum": [
                                  "threshold",
                                  "floyd_steinberg",
                                  "atkinson",
                                  "bayer"
                                ],
                                "type": "string"
                              },
                              "fit": {
                                "default": "contain",
                                "enum": [
                                  "contain",
                                  "cover",
                                  "stretch"
                                ],
                                "type": "string"
                              },
                              "invert": {
                                "default": false,
                                "type": "boolean"
                              },
                              "threshold": {
                                "default": 128,
                                "description": "0–255 cut-off for `threshold` and the gray point for dithering.",
                                "format": "uint8",
                                "maximum": 255,
                                "minimum": 0,
                                "type": "integer"
                              },
                              "type": {
                                "const": "image",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "asset",
                              "fit",
                              "dither",
                              "threshold",
                              "brightness",
                              "contrast",
                              "invert"
                            ],
                            "type": "object"
                          },
                          {
                            "properties": {
                              "corner_radius_mm": {
                                "default": 0.0,
                                "description": "Rect only.",
                                "format": "double",
                                "type": "number"
                              },
                              "fill": {
                                "default": false,
                                "type": "boolean"
                              },
                              "stroke_mm": {
                                "default": 0.3,
                                "format": "double",
                                "type": "number"
                              },
                              "type": {
                                "const": "rect",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "stroke_mm",
                              "fill",
                              "corner_radius_mm"
                            ],
                            "type": "object"
                          },
                          {
                            "properties": {
                              "corner_radius_mm": {
                                "default": 0.0,
                                "description": "Rect only.",
                                "format": "double",
                                "type": "number"
                              },
                              "fill": {
                                "default": false,
                                "type": "boolean"
                              },
                              "stroke_mm": {
                                "default": 0.3,
                                "format": "double",
                                "type": "number"
                              },
                              "type": {
                                "const": "ellipse",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "stroke_mm",
                              "fill",
                              "corner_radius_mm"
                            ],
                            "type": "object"
                          },
                          {
                            "description": "A line from the frame's top-left `(x, y)` to `(x + width, y + height)`.",
                            "properties": {
                              "dash_mm": {
                                "description": "Dash and gap length in mm; solid when absent.",
                                "items": {
                                  "format": "double",
                                  "type": "number"
                                },
                                "maxItems": 2,
                                "minItems": 2,
                                "type": [
                                  "array",
                                  "null"
                                ]
                              },
                              "stroke_mm": {
                                "default": 0.3,
                                "format": "double",
                                "type": "number"
                              },
                              "type": {
                                "const": "line",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "stroke_mm"
                            ],
                            "type": "object"
                          }
                        ],
                        "properties": {
                          "height_mm": {
                            "format": "double",
                            "type": "number"
                          },
                          "hidden": {
                            "default": false,
                            "type": "boolean"
                          },
                          "id": {
                            "description": "Stable element id, unique within a document.",
                            "format": "uint64",
                            "minimum": 0,
                            "type": "integer"
                          },
                          "locked": {
                            "default": false,
                            "type": "boolean"
                          },
                          "name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "rotation_deg": {
                            "default": 0.0,
                            "format": "double",
                            "type": "number"
                          },
                          "width_mm": {
                            "format": "double",
                            "type": "number"
                          },
                          "x_mm": {
                            "format": "double",
                            "type": "number"
                          },
                          "y_mm": {
                            "format": "double",
                            "type": "number"
                          }
                        },
                        "required": [
                          "id",
                          "x_mm",
                          "y_mm",
                          "width_mm",
                          "height_mm",
                          "rotation_deg",
                          "locked",
                          "hidden"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "elements"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "serials": {
                "additionalProperties": {
                  "additionalProperties": false,
                  "description": "A serial number: `prefix + pad(start + step × n, digits) + suffix`, where `n` is the\n0-based position of the label in the print job.",
                  "properties": {
                    "digits": {
                      "default": 0,
                      "description": "Minimum digits; shorter numbers are zero-padded. 0 means no padding.",
                      "format": "uint8",
                      "maximum": 255,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "prefix": {
                      "type": "string"
                    },
                    "start": {
                      "default": 1,
                      "format": "int64",
                      "type": "integer"
                    },
                    "step": {
                      "default": 1,
                      "format": "int64",
                      "type": "integer"
                    },
                    "suffix": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "start",
                    "step",
                    "digits"
                  ],
                  "type": "object"
                },
                "description": "Serial counters usable as `{{name}}`; they advance by one step per label (v2).",
                "type": "object"
              },
              "variables": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Free variables usable as `{{name}}` in string properties.",
                "type": "object"
              }
            },
            "required": [
              "format_version",
              "name",
              "label",
              "pages",
              "next_id"
            ],
            "type": "object"
          },
          "path": {
            "description": "File the document was opened from or last saved to.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "doc_id",
          "path",
          "dirty",
          "can_undo",
          "can_redo",
          "document"
        ],
        "title": "GetOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "default": null,
            "description": "Document id; defaults to the active document.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "DocIdParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Change label stock settings; only the given fields change. Sizes in mm. printer_model \"\" and density 0 clear those fields.",
      "id": "doc.set_label",
      "journal": true,
      "kind": "edit",
      "label": "Label settings",
      "menu": "label",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "label": {
            "additionalProperties": false,
            "description": "Physical label stock.",
            "properties": {
              "corner_radius_mm": {
                "default": 0.0,
                "format": "double",
                "type": "number"
              },
              "density": {
                "description": "Preferred density; the model default is used when absent.",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "height_mm": {
                "description": "Length along the feed, mm.",
                "format": "double",
                "type": "number"
              },
              "media": {
                "default": "gap",
                "description": "Media type of the label stock.",
                "enum": [
                  "gap",
                  "black_mark",
                  "continuous",
                  "transparent"
                ],
                "type": "string"
              },
              "printer_model": {
                "description": "Registry id of the intended printer model, e.g. `niimbot.b21_pro`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "width_mm": {
                "description": "Width across the printhead, mm.",
                "format": "double",
                "type": "number"
              }
            },
            "required": [
              "width_mm",
              "height_mm",
              "corner_radius_mm",
              "media"
            ],
            "type": "object"
          }
        },
        "required": [
          "label"
        ],
        "title": "SetLabelOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "corner_radius_mm": {
            "default": null,
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "density": {
            "default": null,
            "description": "Print density; 0 clears it (model default).",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "height_mm": {
            "default": null,
            "description": "Label length along the feed, mm.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "media": {
            "default": null,
            "description": "Media type of the label stock.",
            "enum": [
              "gap",
              "black_mark",
              "continuous",
              "transparent",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "default": null,
            "description": "Document name.",
            "type": [
              "string",
              "null"
            ]
          },
          "printer_model": {
            "default": null,
            "description": "Printer model id; empty string clears it.",
            "type": [
              "string",
              "null"
            ]
          },
          "width_mm": {
            "default": null,
            "description": "Label width across the printhead, mm.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "title": "SetLabelParams",
        "type": "object"
      },
      "undoable": true
    },
    {
      "description": "Find print problems. Rules: out_of_bounds, in_margin (with margin_mm), outside_printable, label_too_wide, dpi_mismatch, density_out_of_range, paper_mismatch (RFID media of the printer), binding_missing, binding_empty, render_failed, text_overflow, text_shrunk (< 5 pt is a warning), encode_failed, module_too_narrow (< 2 dots), quiet_zone, code_unreadable (render, decode, compare), bad_asset, font_fallback, low_contrast. Returns {ok, dpi, issues:[{rule, severity, element_id?, message, hint}]}; ok is false when any issue has severity error.",
      "id": "doc.check",
      "journal": false,
      "kind": "query",
      "label": "Check document",
      "menu": "label",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "dpi": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "issues": {
            "items": {
              "description": "One `doc.check` finding.",
              "properties": {
                "element_id": {
                  "description": "Stable element id, unique within a document.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "hint": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "rule": {
                  "description": "Rule id, e.g. `out_of_bounds`, `text_overflow`, `code_unreadable`.",
                  "type": "string"
                },
                "severity": {
                  "description": "How serious a check finding is.",
                  "enum": [
                    "info",
                    "warning",
                    "error"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "rule",
                "severity",
                "message",
                "hint"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "ok": {
            "description": "True when there are no `error` issues.",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "dpi",
          "issues"
        ],
        "title": "CheckOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "address": {
            "default": null,
            "description": "Printer whose loaded paper (RFID) is compared with the label. Defaults to the only\nconnected printer, if exactly one is connected.",
            "type": [
              "string",
              "null"
            ]
          },
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "dpi": {
            "default": null,
            "description": "Check resolution in dpi; defaults to the label's printer model dpi, else 203.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "margin_mm": {
            "default": null,
            "description": "Safe margin from the label edge in mm; elements inside it are reported. Default 0.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "title": "CheckParams",
        "type": "object"
      },
      "shortcut": "Ctrl+K",
      "undoable": false
    },
    {
      "description": "Add a text box. Frame in mm (x_mm, y_mm = top-left; width_mm, height_mm), rotation_deg clockwise; font_size_pt in points. `{{name}}` binds a variable. Returns {id}.",
      "id": "element.add_text",
      "journal": true,
      "kind": "edit",
      "label": "Add text",
      "menu": "insert",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "description": "Id of the new element.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "title": "AddOutput",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "align": {
            "default": null,
            "enum": [
              "left",
              "center",
              "right",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "bold": {
            "default": null,
            "type": [
              "boolean",
              "null"
            ]
          },
          "doc_id": {
            "default": null,
            "description": "Document id; defaults to the active document.",
            "type": [
              "string",
              "null"
            ]
          },
          "fit": {
            "anyOf": [
              {
                "description": "How text reacts when it does not fit its box.",
                "oneOf": [
                  {
                    "const": "none",
                    "description": "Keep the size; overflow is reported by `doc.check`.",
                    "type": "string"
                  },
                  {
                    "const": "shrink",
                    "description": "Shrink the font until the text fits.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "`none` (default; overflow reported by doc.check) or `shrink`."
          },
          "font_family": {
            "default": null,
            "description": "Font family (default `Noto Sans`).",
            "type": [
              "string",
              "null"
            ]
          },
          "font_size_pt": {
            "default": null,
            "description": "Font size in points (default 12).",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "height_mm": {
            "description": "Frame height, mm.",
            "format": "double",
            "type": "number"
          },
          "invert": {
            "default": null,
            "description": "White text on black.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "italic": {
            "default": null,
            "type": [
              "boolean",
              "null"
            ]
          },
          "letter_spacing_mm": {
            "default": null,
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "line_spacing": {
            "default": null,
            "description": "Line height multiplier (default 1.0).",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "name": {
            "default": null,
            "description": "Optional element name.",
            "type": [
              "string",
              "null"
            ]
          },
          "rotation_deg": {
            "default": null,
            "description": "Clockwise rotation about the frame centre, degrees (default 0).",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "text": {
            "description": "Text; may contain `{{variable}}` bindings and newlines.",
            "type": "string"
          },
          "underline": {
            "default": null,
            "type": [
              "boolean",
              "null"
            ]
          },
          "valign": {
            "default": null,
            "enum": [
              "top",
              "middle",
              "bottom",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "width_mm": {
            "description": "Frame width, mm.",
            "format": "double",
            "type": "number"
          },
          "wrap": {
            "default": null,
            "description": "Wrap at the frame width (default true).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "x_mm": {
            "description": "Left edge of the unrotated frame, mm from the label's left edge.",
            "format": "double",
            "type": "number"
          },
          "y_mm": {
            "description": "Top edge of the unrotated frame, mm from the label's top edge.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "x_mm",
          "y_mm",
          "width_mm",
          "height_mm",
          "text"
        ],
        "title": "TextParams",
        "type": "object"
      },
      "shortcut": "T",
      "undoable": true
    },
