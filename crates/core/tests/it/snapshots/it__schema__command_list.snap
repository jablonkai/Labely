      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Paper id from paper.list or paper.detect.",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "ApplyParams",
        "type": "object"
      },
      "undoable": true
    },
    {
      "description": "Add a paper to the user's library. Sizes in mm; media defaults to gap. Returns the paper with its new `my:` id. With `barcode`, also links that RFID barcode to it. Not undoable; remove it with paper.delete.",
      "id": "paper.add",
      "journal": false,
      "kind": "edit",
      "label": "Add label paper",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "A paper as listed: the paper plus where it comes from and its linked barcodes.",
        "properties": {
          "barcodes": {
            "description": "RFID barcodes linked to this paper.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "corner_radius_mm": {
            "default": 0.0,
            "format": "double",
            "type": "number"
          },
          "custom": {
            "description": "True for the user's own papers (`my:`), false for bundled ones (`std:`).",
            "type": "boolean"
          },
          "height_mm": {
            "description": "Length along the feed, mm (the default length for continuous rolls).",
            "format": "double",
            "type": "number"
          },
          "id": {
            "description": "`std:<…>` (bundled) or `my:<…>` (user).",
            "type": "string"
          },
          "media": {
            "default": "gap",
            "description": "Media type of the label stock.",
            "enum": [
              "gap",
              "black_mark",
              "continuous",
              "transparent"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "width_mm": {
            "description": "Width across the printhead, mm.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "width_mm",
          "height_mm",
          "corner_radius_mm",
          "media",
          "custom"
        ],
        "title": "PaperEntry",
        "type": "object"
      },
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "barcode": {
            "default": null,
            "description": "Also link this RFID barcode to the new paper.",
            "type": [
              "string",
              "null"
            ]
          },
          "corner_radius_mm": {
            "default": null,
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "height_mm": {
            "description": "Length along the feed, mm.",
            "format": "double",
            "type": "number"
          },
          "media": {
            "default": null,
            "description": "Default `gap`.",
            "enum": [
              "gap",
              "black_mark",
              "continuous",
              "transparent",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "width_mm": {
            "description": "Width across the printhead, mm.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "name",
          "width_mm",
          "height_mm"
        ],
        "title": "AddParams",
        "type": "object"
      },
      "undoable": false
    },
    {
      "description": "Delete one of the user's papers (`my:…`) and its barcode links. Bundled papers cannot be deleted. Cannot be undone.",
      "id": "paper.delete",
