        }
      }
    },
    "intent_err_timeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The print did not finish in time. The print queue may be paused."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyomtatás nem fejeződött be időben. Lehet, hogy a nyomtatási sor szünetel."
