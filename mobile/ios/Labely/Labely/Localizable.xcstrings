    },
    "intent_err_empty_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is empty."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szöveg üres."
          }
        }
      }
    },
    "intent_err_field_line": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not name=value."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nem név=érték alakú."
          }
        }
      }
    },
    "intent_err_no_field": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The template has no field “%1$@”. Its fields: %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sablonnak nincs „%1$@” mezője. A mezői: %2$@."
          }
        }
      }
    },
    "intent_err_no_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no saved label “%@”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs „%@” mentett címke."
          }
        }
      }
    },
    "intent_err_no_printer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No printer is chosen. Connect one in Labely or pick one."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs kiválasztott nyomtató. Csatlakozz egyhez a Labelyben, vagy válassz egyet."
          }
        }
      }
    },
    "intent_err_no_template": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no template “%@”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs „%@” sablon."
          }
        }
      }
    },
    "intent_err_print_consent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labely does not let assistants print yet. Turn on “%@” in Labely’s settings."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Labely még nem engedi az asszisztenseknek a nyomtatást. Kapcsold be a Labely beállításaiban: „%@”."
          }
        }
      }
    },
    "intent_err_print_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The print failed: %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyomtatás nem sikerült: %@"
          }
        }
      }
    },
    "intent_err_size": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ label is out of range (10–120 × 5–120 mm)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ méretű címke kívül esik a tartományon (10–120 × 5–120 mm)."
