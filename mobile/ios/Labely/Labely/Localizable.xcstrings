    "intent_template_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a label from a template, fills in its fields and saves it, ready to print. Give each field as name=value; the others keep their sample value."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Címkét készít egy sablonból, kitölti a mezőit, és nyomtatásra készen elmenti. Minden mezőt név=érték alakban adj meg; a többi megtartja a mintaértékét."
          }
        }
      }
    },
