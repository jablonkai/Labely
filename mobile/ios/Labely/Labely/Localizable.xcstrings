    "intent_print_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prints a saved label and waits until it has printed. Turn on “Allow assistants to print” in Labely’s settings first."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinyomtat egy mentett címkét, és megvárja, amíg elkészül. Előbb kapcsold be a Labely beállításaiban: „Nyomtathatnak az asszisztensek”."
          }
        }
      }
    },
    "intent_print_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Print Label"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Címke nyomtatása"
          }
        }
      }
    },
    "intent_printed_dialog": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Printed “%1$@”: %2$lld of %3$lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” kinyomtatva: %2$lld/%3$lld."
          }
        }
      }
    },
    "intent_printers_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists the connected printer and those Labely connected to before. Search nearby takes about 5 seconds."
          }
        },
        "hu": {
