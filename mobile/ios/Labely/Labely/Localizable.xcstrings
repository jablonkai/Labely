    "intent_err_bluetooth": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is off or not allowed. Turn it on and open Labely once to allow it."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bluetooth ki van kapcsolva vagy nincs engedélyezve. Kapcsold be, és nyisd meg egyszer a Labelyt az engedélyezéshez."
          }
        }
      }
    },
    "intent_err_copies": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies must be 1 to %lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A példányszám 1 és %lld között lehet."
